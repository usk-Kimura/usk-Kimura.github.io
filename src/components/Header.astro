---
import type { Locale } from '~/data/types';
import { t } from '~/i18n/ui';
import { L, localizePath } from '~/i18n/locale';
import { profile } from '~/data';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitcher from './LangSwitcher.astro';

type Props = {
  locale: Locale;
  /** This same page in every locale, for the language switcher. */
  paths: Record<Locale, string>;
  /** Match the wider document measure used by the CV, so the header lines up
   *  with the page content instead of floating inside it. */
  wide?: boolean;
};

const { locale, paths, wide = false } = Astro.props;
const s = t(locale);
const home = localizePath('/', locale);
---

<header
  class="sticky top-0 z-40 border-b hairline no-print"
  style="height: var(--header-h); background: color-mix(in oklch, var(--bg) 88%, transparent); backdrop-filter: blur(8px);"
>
  <div class:list={[wide ? 'container-wide' : 'container-page', 'flex h-full items-center gap-2']}>
    <a href={home} class="min-w-0 truncate font-semibold tracking-tight">
      {L(profile.name, locale)}
    </a>

    {/* Hidden on the narrowest screens: at 320px these links squeeze the name
        down to a few characters, and both destinations are reachable from the
        page body and the footer. */}
    <nav aria-label={s.labels.mainNav} class="ml-auto hidden items-center gap-0.5 text-sm sm:flex">
      <a href={localizePath('/publications/', locale)} class="link-quiet rounded-md px-2 py-2">
        {s.nav.publications}
      </a>
      <a href={localizePath('/cv/', locale)} class="link-quiet rounded-md px-2 py-2">
        {s.nav.cv}
      </a>
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-1 sm:ml-0">
      <LangSwitcher locale={locale} paths={paths} />
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>
