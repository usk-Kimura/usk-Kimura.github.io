---
import type { Locale } from '~/data/types';
import { t } from '~/i18n/ui';
import { L, localizePath } from '~/i18n/locale';
import { profile } from '~/data';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitcher from './LangSwitcher.astro';

type Props = {
  locale: Locale;
  /** This same page in every locale, for the language switcher. */
  paths: Record<Locale, string>;
  /** Match the wider document measure used by the CV, so the header lines up
   *  with the page content instead of floating inside it. */
  wide?: boolean;
  /** Match the wider, structured introduction used only on landing pages. */
  homePage?: boolean;
};

const { locale, paths, wide = false, homePage = false } = Astro.props;
const s = t(locale);
const home = localizePath('/', locale);
const publications = localizePath('/publications/', locale);
const cv = localizePath('/cv/', locale);
const activity = `${home}#activity`;
const research = `${home}#research`;
const awards = `${home}#awards`;
const contact = `${home}#contact`;
const normalizePath = (path: string) => path.replace(/\/$/, '') || '/';
const currentPath = normalizePath(Astro.url.pathname);
---

<header
  class="sticky top-0 z-40 border-b hairline no-print"
  style="height: var(--header-h); background: color-mix(in oklch, var(--bg) 88%, transparent); backdrop-filter: blur(8px);"
>
  <div
    class:list={[
      wide ? 'container-wide' : homePage ? 'container-home' : 'container-page',
      'flex h-full items-center gap-2',
    ]}
  >
    <a href={home} class="min-w-0 truncate font-semibold tracking-tight">
      {L(profile.name, locale)}
    </a>

    {/* Hidden on the narrowest screens: at 320px navigation squeezes the name
        down to a few characters. Research and Contact join the two core page
        links only when the desktop header has enough room. */}
    <nav aria-label={s.labels.mainNav} class="ml-auto hidden items-center gap-0.5 text-sm sm:flex">
      <a
        href={activity}
        class="link-quiet hidden min-h-10 items-center rounded-md px-2 py-2 lg:inline-flex"
      >
        {s.sections.activity}
      </a>
      <a
        href={research}
        class="link-quiet hidden min-h-10 items-center rounded-md px-2 py-2 xl:inline-flex"
      >
        {s.nav.research}
      </a>
      <a
        href={publications}
        class="link-quiet inline-flex min-h-10 items-center rounded-md px-2 py-2"
        aria-current={currentPath === normalizePath(publications) ? 'page' : undefined}
      >
        {s.nav.publications}
      </a>
      <a
        href={cv}
        class="link-quiet inline-flex min-h-10 items-center rounded-md px-2 py-2"
        aria-current={currentPath === normalizePath(cv) ? 'page' : undefined}
      >
        {s.nav.cv}
      </a>
      <a
        href={contact}
        class="link-quiet hidden min-h-10 items-center rounded-md px-2 py-2 lg:inline-flex"
      >
        {s.nav.contact}
      </a>
    </nav>

    <details class="mobile-site-menu relative ml-auto sm:hidden">
      <summary class="inline-flex min-h-10 cursor-pointer list-none items-center rounded-md px-2 text-sm text-muted">
        {s.labels.menu}
      </summary>
      <nav
        aria-label={s.labels.mainNav}
        class="absolute top-[calc(100%+.35rem)] left-0 z-50 w-52 rounded-lg border p-1.5 text-sm shadow-lg hairline"
        style="background: var(--bg);"
      >
        <a href={activity} class="link-quiet block min-h-10 rounded-md px-3 py-2">{s.sections.activity}</a>
        <a href={research} class="link-quiet block min-h-10 rounded-md px-3 py-2">{s.nav.research}</a>
        <a href={publications} class="link-quiet block min-h-10 rounded-md px-3 py-2">{s.nav.publications}</a>
        <a href={awards} class="link-quiet block min-h-10 rounded-md px-3 py-2">{s.nav.awards}</a>
        <a href={cv} class="link-quiet block min-h-10 rounded-md px-3 py-2">{s.nav.cv}</a>
        <a href={contact} class="link-quiet block min-h-10 rounded-md px-3 py-2">{s.nav.contact}</a>
      </nav>
    </details>

    <div class="flex shrink-0 items-center gap-1 sm:ml-0">
      <LangSwitcher locale={locale} paths={paths} />
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>

<script>
  const languageMenu = document.querySelector<HTMLDetailsElement>('[data-lang-menu]');

  for (const menu of document.querySelectorAll<HTMLDetailsElement>('.mobile-site-menu')) {
    for (const link of menu.querySelectorAll('a')) {
      link.addEventListener('click', () => menu.removeAttribute('open'));
    }

    menu.addEventListener('toggle', () => {
      if (menu.open && languageMenu?.open) languageMenu.open = false;
    });

    languageMenu?.addEventListener('toggle', () => {
      if (languageMenu.open && menu.open) menu.open = false;
    });

    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.open) return;
      menu.open = false;
      menu.querySelector('summary')?.focus();
    });
  }
</script>

<style>
  .mobile-site-menu > summary::-webkit-details-marker {
    display: none;
  }

  .mobile-site-menu[open] > summary {
    color: var(--fg);
    background: var(--bg-soft);
  }
</style>
