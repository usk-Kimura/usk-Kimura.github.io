---
import type { Locale } from '~/data/types';
import { profile } from '~/data';
import { t } from '~/i18n/ui';
import { L } from '~/i18n/locale';
import Section from './Section.astro';

type Props = { locale: Locale };
const { locale } = Astro.props;
const s = t(locale);

const primary = profile.emails.find((e) => e.primary) ?? profile.emails[0];
const others = profile.emails.filter((e) => e !== primary);
const profileLinks = profile.links.filter((l) => !l.social);
const socialLinks = profile.links.filter((l) => l.social);
---

<Section id="contact" title={s.sections.contact} home>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
    <a href={`mailto:${primary.address}`} class="link text-lg break-all sm:text-xl">
      {primary.address}
    </a>
    <button
      type="button"
      class="copy-email btn h-8 min-h-8 text-xs"
      data-email={primary.address}
      data-copy={s.labels.copyEmail}
      data-copied={s.labels.copied}
    >
      {s.labels.copyEmail}
    </button>
  </div>
  <p class="mt-1 text-sm text-muted">{L(primary.label, locale)}</p>

  {
    others.length > 0 && (
      <ul class="mt-4 space-y-1.5 text-sm">
        {others.map((email) => (
          <li class="flex flex-wrap items-baseline gap-x-2">
            <a href={`mailto:${email.address}`} class="link break-all">
              {email.address}
            </a>
            <span class="text-muted">{L(email.label, locale)}</span>
          </li>
        ))}
      </ul>
    )
  }

  <span id="copy-status" role="status" aria-live="polite" class="sr-only"></span>

  <div class="mt-8 grid gap-6 sm:grid-cols-2">
    <div>
      <h3 class="text-sm font-semibold text-muted">{s.labels.researchProfiles}</h3>
      <ul class="mt-1.5 space-y-1.5 text-sm">
        {
          profileLinks.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener noreferrer" class="link">
                {L(l.label, locale)}
                <span aria-hidden="true"> ↗</span>
                <span class="sr-only">{s.labels.newTab}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      socialLinks.length > 0 && (
        <div>
          <h3 class="text-sm font-semibold text-muted">{s.labels.social}</h3>
          <ul class="mt-1.5 space-y-1.5 text-sm">
            {socialLinks.map((l) => (
              <li>
                <a href={l.href} target="_blank" rel="noreferrer me" class="link-quiet">
                  {L(l.label, locale)}
                  <span aria-hidden="true"> ↗</span>
                  <span class="sr-only">{s.labels.newTab}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</Section>

<script>
  const status = document.getElementById('copy-status');

  for (const btn of document.querySelectorAll<HTMLButtonElement>('.copy-email')) {
    const idle = btn.dataset.copy ?? 'Copy';
    const done = btn.dataset.copied ?? 'Copied';

    btn.addEventListener('click', async () => {
      const address = btn.dataset.email ?? '';
      try {
        await navigator.clipboard.writeText(address);
        btn.textContent = done;
        if (status) status.textContent = `${done}: ${address}`;
        setTimeout(() => {
          if (btn.textContent === done) btn.textContent = idle;
          if (status) status.textContent = '';
        }, 1500);
      } catch {
        // Clipboard blocked (insecure context, permission denied): leave the
        // address on screen so it can still be selected manually.
        if (status) status.textContent = address;
      }
    });
  }
</script>
