---
import type { Locale } from '~/data/types';
import { buildUpcoming } from '~/data/recent';

type Props = { locale: Locale };
const { locale } = Astro.props;
const events = buildUpcoming(locale);
const heading = events[0]?.title ?? '';

function formatEventRange(start: string, end?: string): string {
  const startDate = new Date(`${start}T00:00:00Z`);
  const endDate = new Date(`${end ?? start}T00:00:00Z`);

  if (locale === 'ja') {
    const year = startDate.getUTCFullYear();
    const startMonth = startDate.getUTCMonth() + 1;
    const startDay = startDate.getUTCDate();
    const endMonth = endDate.getUTCMonth() + 1;
    const endDay = endDate.getUTCDate();
    if (!end || end === start) return `${year}年${startMonth}月${startDay}日`;
    const endLabel = startMonth === endMonth ? `${endDay}日` : `${endMonth}月${endDay}日`;
    return `${year}年${startMonth}月${startDay}日 — ${endLabel}`;
  }

  const formatter = new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
  return !end || end === start ? formatter.format(startDate) : formatter.formatRange(startDate, endDate);
}
---

{
  events.length > 0 && (
    <section
      id="upcoming-presentations"
      class="upcoming-showcase overflow-hidden rounded-2xl border"
      aria-labelledby="upcoming-heading"
      data-upcoming-section
    >
      <div class="upcoming-lead relative overflow-hidden p-6 md:p-8">
        <div class="relative z-10">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <p class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em]">
              <span class="h-2.5 w-2.5 rounded-full bg-[var(--upcoming-signal)]" aria-hidden="true" />
              {locale === 'ja' ? '今後の発表' : 'Upcoming presentations'}
            </p>
            <p class="rounded-full border border-white/30 bg-white/10 px-3 py-1 text-xs font-semibold">
              {locale === 'ja' ? `${events.length}件の発表予定` : `${events.length} scheduled talks`}
            </p>
          </div>

          <h2 id="upcoming-heading" class="mt-4 max-w-3xl text-xl font-bold leading-relaxed text-balance md:text-2xl">
            {heading}
          </h2>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-[var(--upcoming-muted)]">
            {locale === 'ja'
              ? '同じ研究テーマを、YANS 2026と第269回自然言語処理研究発表会で発表します。'
              : 'The same research topic will be presented at YANS 2026 and the 269th IPSJ SIG-NL meeting.'}
          </p>
        </div>
      </div>

      <ol class="grid gap-3 bg-[var(--upcoming-list-bg)] p-3 sm:grid-cols-2 md:gap-4 md:p-4">
        {events.map((event) => (
          <li
            class="event-row min-w-0"
            data-event-row
            data-event-start={event.date}
            data-event-end={event.endDate ?? event.date}
          >
            <a
              href={event.href}
              target="_blank"
              rel="noopener noreferrer"
              class="event-link flex h-full min-h-64 flex-col rounded-xl border bg-[var(--bg-elev)] p-5 transition-[border-color,box-shadow,transform] hover:-translate-y-0.5 hover:border-[var(--accent)] hover:shadow-md"
            >
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="rounded-full bg-[var(--accent-soft)] px-2.5 py-1 text-xs font-bold tracking-wide text-[var(--accent-strong)]">
                  {event.event?.label ?? (locale === 'ja' ? '発表' : 'Talk')}
                </span>
                <span
                  class="event-status rounded-full border px-2.5 py-1 text-xs font-bold tabular-nums"
                  data-event-status
                  data-locale={locale}
                >
                  {locale === 'ja' ? '発表予定' : 'Scheduled'}
                </span>
              </div>

              <time class="mt-5 block text-sm font-bold tabular-nums text-[var(--highlight)]" datetime={event.date}>
                {formatEventRange(event.date, event.endDate)}
              </time>
              <h3 class="mt-2 text-base font-bold leading-relaxed md:text-lg">
                {event.event?.name ?? event.detail}
              </h3>

              {event.event?.venue && (
                <p class="mt-3 flex items-start gap-2 text-sm leading-relaxed text-muted">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-[var(--accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
                    <circle cx="12" cy="10" r="2.5" />
                  </svg>
                  <span>
                    <span class="font-semibold text-[var(--fg)]">{locale === 'ja' ? '会場' : 'Venue'}</span>
                    <span aria-hidden="true"> · </span>{event.event.venue}
                  </span>
                </p>
              )}

              <span class="mt-auto inline-flex min-h-10 w-fit items-center gap-1 pt-4 text-sm font-bold text-[var(--accent-strong)]">
                {locale === 'ja' ? '開催案内を見る' : 'View event details'}
                <span aria-hidden="true">↗</span>
                <span class="sr-only">{locale === 'ja' ? '（新しいタブで開きます）' : '(opens in a new tab)'}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )
}

<script>
  const eventRows = Array.from(document.querySelectorAll<HTMLElement>('[data-event-row]'));
  const upcomingSection = document.querySelector<HTMLElement>('[data-upcoming-section]');
  const day = 86_400_000;
  const now = Date.now();
  let nextRow: HTMLElement | undefined;
  let nextStart = Number.POSITIVE_INFINITY;
  let visibleEvents = 0;

  for (const row of eventRows) {
    const startValue = row.dataset.eventStart;
    const endValue = row.dataset.eventEnd ?? startValue;
    if (!startValue || !endValue) continue;

    const start = new Date(`${startValue}T00:00:00+09:00`).getTime();
    const end = new Date(`${endValue}T23:59:59+09:00`).getTime();
    const status = row.querySelector<HTMLElement>('[data-event-status]');
    const statusLocale = status?.dataset.locale ?? 'ja';

    if (now > end) {
      row.hidden = true;
      continue;
    }

    visibleEvents += 1;
    if (now >= start) {
      if (status) status.textContent = statusLocale === 'ja' ? '開催中' : 'In progress';
    } else {
      const days = Math.max(1, Math.ceil((start - now) / day));
      if (status) {
        status.textContent = statusLocale === 'ja'
          ? days === 1 ? '明日' : `あと${days}日`
          : days === 1 ? 'Tomorrow' : `In ${days} days`;
      }
      if (start < nextStart) {
        nextStart = start;
        nextRow = row;
      }
    }
  }

  if (nextRow) nextRow.dataset.nextEvent = 'true';
  if (upcomingSection && visibleEvents === 0) upcomingSection.hidden = true;
</script>
