---
import type { Locale } from '~/data/types';
import { profile } from '~/data';
import { t } from '~/i18n/ui';
import { L, localizePath } from '~/i18n/locale';
import Portrait from './Portrait.astro';

type Props = { locale: Locale };
const { locale } = Astro.props;
const s = t(locale);

const opp = profile.openToOpportunities;
const name = L(profile.name, locale);
const reading = L(profile.reading, locale);
const showReading = reading !== name;
const primaryEmail = profile.emails.find((e) => e.primary) ?? profile.emails[0];
const profileLinks = profile.links.filter((l) => !l.social);
const publications = localizePath('/publications/', locale);
const cv = localizePath('/cv/', locale);
---

<section class="container-home pt-9 pb-10 md:pt-12 md:pb-12">
  <div class="flex flex-col lg:grid lg:grid-cols-[minmax(0,1.35fr)_minmax(19rem,.85fr)] lg:gap-x-12">
    {/* `contents` lets mobile place the facts between identity and biography;
        at desktop this becomes one left column so the tall aside cannot create
        an empty grid row between the name and biography. */}
    <div class="contents lg:block">
      <div class="order-1 min-w-0">
        <div class="flex items-start gap-4 sm:gap-6">
          {
            profile.portrait && (
              <Portrait
                locale={locale}
                class="avatar h-[4.5rem] w-[4.5rem] shrink-0 sm:h-24 sm:w-24 lg:h-32 lg:w-32"
                sizes="(min-width: 1024px) 128px, (min-width: 640px) 96px, 72px"
              />
            )
          }
          <div class="min-w-0 flex-1">
            <h1 class="text-[1.75rem] leading-tight font-bold tracking-tight sm:text-4xl lg:text-[2.625rem]">
              {name}
            </h1>
            {showReading && <p class="mt-1 text-sm text-muted">{reading}</p>}
            <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-muted">
              {L(profile.tagline, locale)}
            </p>
          </div>
        </div>
      </div>

      <div class="order-3 mt-7 min-w-0 lg:max-w-[44rem]">
        <p class="text-[0.9375rem] leading-[1.9] md:text-base">{L(profile.bio, locale)}</p>
        <div class="mt-6 flex flex-wrap gap-2.5">
          <a href={publications} class="btn btn-primary">{s.actions.seeAllResearchOutputs}</a>
          <a href={cv} class="btn">{s.actions.viewCv}</a>
        </div>
      </div>
    </div>

    {/* On mobile the essential affiliation facts come before the biography;
        on desktop they form the right-hand reference column. */}
    <aside class="order-2 mt-7 min-w-0 lg:col-start-2 lg:row-start-1 lg:mt-0 lg:pt-0.5">
      <dl class="divided text-sm">
        <div class="grid gap-x-4 py-2.5 sm:grid-cols-[5rem_minmax(0,1fr)] lg:block lg:py-3">
          <dt class="text-muted">{s.labels.position}</dt>
          <dd class="lg:mt-0.5">{L(profile.position, locale)}</dd>
        </div>
        <div class="grid gap-x-4 py-2.5 sm:grid-cols-[5rem_minmax(0,1fr)] lg:block lg:py-3">
          <dt class="text-muted">{s.labels.affiliation}</dt>
          <dd class="lg:mt-0.5">{L(profile.affiliation, locale)}</dd>
        </div>
        <div class="grid gap-x-4 py-2.5 sm:grid-cols-[5rem_minmax(0,1fr)] lg:block lg:py-3">
          <dt class="text-muted">{s.labels.degree}</dt>
          <dd class="lg:mt-0.5">{L(profile.degree, locale)}</dd>
        </div>
        <div class="grid gap-x-4 py-2.5 sm:grid-cols-[5rem_minmax(0,1fr)] lg:block lg:py-3">
          <dt class="text-muted">{s.labels.email}</dt>
          <dd class="lg:mt-0.5">
            <a href={`mailto:${primaryEmail.address}`} class="link break-all">
              {primaryEmail.address}
            </a>
          </dd>
        </div>
      </dl>

      {
        opp && (
          <p class="mt-6 border-l-2 pl-3.5 text-sm leading-relaxed" style="border-color: var(--accent);">
            <a href="#contact" class="font-medium text-[var(--accent-strong)]">
              {s.opportunities.heading}
            </a>
            <span class="text-muted">
              <span aria-hidden="true"> — </span>
              {L(opp.startFrom, locale)}
              <span aria-hidden="true"> · </span>
              {L(opp.detail, locale)}
            </span>
          </p>
        )
      }

      <ul class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
        {profileLinks.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="link">
              {L(link.label, locale)}
              <span class="sr-only">{s.labels.newTab}</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>

  </div>
</section>
