---
import type { Locale } from '~/data/types';
import { profile } from '~/data';
import { buildRecent } from '~/data/recent';
import { stats } from '~/data/stats';
import { formatYearMonth, isoYearMonth } from '~/i18n/format';
import { t } from '~/i18n/ui';
import Portrait from './Portrait.astro';

type Props = { locale: Locale };
const { locale } = Astro.props;
const s = t(locale);

const recents = buildRecent(locale, 4);
const opp = profile.openToOpportunities;
const researchmapUpdatedLabel = new Intl.DateTimeFormat(locale === 'ja' ? 'ja-JP' : 'en-US', {
  year: 'numeric',
  month: locale === 'ja' ? 'numeric' : 'short',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${profile.researchmapUpdated}T00:00:00Z`));

const highlights: { value: string; label: string }[] = [
  { value: String(stats.publications), label: locale === 'ja' ? '論文' : 'Publications' },
  { value: String(stats.firstAuthor), label: locale === 'ja' ? '筆頭著者論文' : 'First-author papers' },
  { value: String(stats.peerReviewed), label: locale === 'ja' ? '査読付き論文' : 'Peer-reviewed papers' },
  { value: String(stats.hpcAllocations), label: locale === 'ja' ? '計算資源採択' : 'Compute allocations' },
];
---

<section class="relative overflow-hidden">
  <div
    class="absolute inset-0 -z-10 opacity-40 pointer-events-none"
    aria-hidden="true"
    style="background:
      radial-gradient(700px 280px at 14% 0%, color-mix(in oklch, var(--accent) 18%, transparent), transparent 60%),
      radial-gradient(560px 240px at 92% 14%, color-mix(in oklch, var(--accent) 10%, transparent), transparent 60%);"
  >
  </div>

  <div class="container-page pt-12 pb-12 md:pt-16 md:pb-16">
    <div class="grid sm:grid-cols-[1fr_auto] gap-8 lg:gap-12 items-start">
      <div>
        <p class="text-sm font-medium tracking-[0.08em] text-[var(--accent)]">
          {profile.tagline[locale]}
        </p>

        <h1
          class="mt-3 font-serif text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight leading-[1.08]"
        >
          {profile.name[locale]}
        </h1>
        {locale === 'ja' && <p class="mt-2 text-sm text-muted">{profile.reading.ja}</p>}

        <dl class="mt-7 grid max-w-3xl gap-2 text-sm">
          <div class="grid grid-cols-[4.5rem_minmax(0,1fr)] gap-3 border-b hairline pb-2">
            <dt class="text-muted">{s.labels.position}</dt>
            <dd class="font-medium">{profile.position[locale]}</dd>
          </div>
          <div class="grid grid-cols-[4.5rem_minmax(0,1fr)] gap-3 border-b hairline pb-2">
            <dt class="text-muted">{s.labels.affiliation}</dt>
            <dd>{profile.affiliation[locale]}</dd>
          </div>
          <div class="grid grid-cols-[4.5rem_minmax(0,1fr)] gap-3">
            <dt class="text-muted">{s.labels.degree}</dt>
            <dd>{profile.degree[locale]}</dd>
          </div>
        </dl>

        <a
          href={profile.researchmap}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-1.5 text-xs text-muted hover:text-[var(--fg)] hover:underline underline-offset-4"
        >
          {s.labels.researchmapUpdated}: <time datetime={profile.researchmapUpdated}>{researchmapUpdatedLabel}</time>
          <span aria-hidden="true">↗</span>
          <span class="sr-only">{locale === 'ja' ? '（新しいタブで開きます）' : '(opens in a new tab)'}</span>
        </a>
      </div>

      {
        profile.portrait && (
          <Portrait
            locale={locale}
            class="hero-portrait shrink-0 w-28 sm:w-36 md:w-40 lg:w-48 aspect-square rounded-2xl overflow-hidden border hairline shadow-sm justify-self-start sm:justify-self-end"
          />
        )
      }
    </div>

    <div class="mt-8 flex flex-wrap gap-2">
      <a
        href="#publications"
        class="inline-flex min-h-11 items-center gap-2 px-4 py-2 rounded-md bg-[var(--accent)] text-[var(--accent-contrast)] text-sm font-medium hover:opacity-90 transition-opacity"
      >
        {s.nav.publications}
        <span aria-hidden="true">→</span>
      </a>
      <a
        href={locale === 'ja' ? '/cv' : '/en/cv'}
        class="inline-flex min-h-11 items-center gap-2 px-4 py-2 rounded-md border hairline text-sm font-medium hover:bg-[var(--accent-soft)] transition-colors"
      >
        {locale === 'ja' ? '履歴書 (CV)' : 'Curriculum Vitae'}
      </a>
      <a
        href="#contact"
        class="inline-flex min-h-11 items-center gap-2 px-4 py-2 rounded-md border hairline text-sm font-medium hover:bg-[var(--accent-soft)] transition-colors"
      >
        {s.nav.contact}
      </a>
    </div>

    {
      opp && (
        <a
          href="#contact"
          class="group mt-6 flex max-w-4xl flex-col gap-1 rounded-xl border-l-4 border-[var(--accent)] bg-[var(--accent-soft)] px-4 py-3 text-sm sm:flex-row sm:items-center sm:gap-3 transition-colors hover:bg-[var(--bg-elev)]"
        >
          <span class="inline-flex shrink-0 items-center gap-2 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-[var(--accent)]">
            <span class="inline-flex w-2 h-2 rounded-full bg-[var(--accent)]" aria-hidden="true" />
            {locale === 'ja' ? '次のポストを探しています' : 'Looking for a position'}
          </span>
          <span>
            <strong class="font-semibold">{opp.startFrom[locale]}</strong>
            {' — '}{opp.detail[locale]}
          </span>
          <span aria-hidden="true" class="sm:ml-auto text-[var(--accent)]">→</span>
        </a>
      )
    }

    <dl class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-px max-w-3xl rounded-xl overflow-hidden border hairline bg-[var(--border)]">
      {
        highlights.map((h) => (
          <div class="flex flex-col bg-[var(--bg)] px-4 py-3 text-center sm:text-left">
            <dt class="mt-1 text-xs leading-tight text-muted">
              {h.label}
            </dt>
            <dd class="order-first font-serif text-2xl md:text-3xl font-semibold tabular-nums leading-none">
              {h.value}
            </dd>
          </div>
        ))
      }
    </dl>

    {
      recents.length > 0 && (
        <section class="mt-8 max-w-4xl surface p-5 md:p-6" aria-labelledby="recent-heading">
          <h2
            id="recent-heading"
            class="text-xs font-mono uppercase tracking-[0.18em] text-[var(--accent)] mb-2"
          >
            {s.recent.heading}
          </h2>
          <ul class="divide-y hairline">
            {recents.map((item) => {
              const dateLabel = formatYearMonth(item.date.slice(0, 7), locale);
              const dateAttr = isoYearMonth(item.date.slice(0, 7));
              const content = (
                <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4 py-3">
                  <div class="sm:w-36 shrink-0 flex items-baseline gap-3">
                    <time class="font-mono text-xs text-muted tabular-nums" datetime={dateAttr}>
                      {dateLabel}
                    </time>
                    <span class="text-xs font-mono tracking-wide text-[var(--accent)]">
                      {s.newsKinds[item.kind]}
                    </span>
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium leading-snug">{item.title}</p>
                    {item.detail && (
                      <p class="mt-1 text-xs leading-relaxed text-muted">{item.detail}</p>
                    )}
                  </div>
                </div>
              );
              return (
                <li>
                  {item.href ? (
                    <a
                      href={item.href}
                      class="block hover:bg-[var(--accent-soft)] -mx-2 px-2 rounded-md transition-colors"
                    >
                      {content}
                    </a>
                  ) : (
                    content
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      )
    }
  </div>
</section>

<style>
  .hero-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
