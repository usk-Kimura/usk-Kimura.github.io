---
import type { Locale } from '~/data/types';
import { profile } from '~/data';
import { buildUpcoming } from '~/data/recent';
import { stats } from '~/data/stats';
import { t } from '~/i18n/ui';
import Portrait from './Portrait.astro';

type Props = { locale: Locale };
const { locale } = Astro.props;
const s = t(locale);

const upcoming = buildUpcoming(locale);
const upcomingGroups = Array.from(
  upcoming.reduce<Map<string, typeof upcoming>>((groups, item) => {
    const group = groups.get(item.title) ?? [];
    group.push(item);
    groups.set(item.title, group);
    return groups;
  }, new Map()),
);
const upcomingHeading = upcomingGroups[0]?.[0] ?? '';
const eventDateFormatter = new Intl.DateTimeFormat(locale === 'ja' ? 'ja-JP' : 'en-US', {
  year: 'numeric',
  month: locale === 'ja' ? 'numeric' : 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
function formatEventRange(start: string, end?: string): string {
  const startDate = new Date(`${start}T00:00:00Z`);
  if (!end || end === start) return eventDateFormatter.format(startDate);
  return eventDateFormatter.formatRange(startDate, new Date(`${end}T00:00:00Z`));
}

const opp = profile.openToOpportunities;
const focusStatement = locale === 'ja'
  ? '大規模言語モデルを、効率的かつ信頼できる形で事後学習・適応させる方法を研究しています。'
  : 'I study how to post-train and adapt large language models efficiently and reliably.';
const researchmapUpdatedLabel = new Intl.DateTimeFormat(locale === 'ja' ? 'ja-JP' : 'en-US', {
  year: 'numeric',
  month: locale === 'ja' ? 'numeric' : 'short',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${profile.researchmapUpdated}T00:00:00Z`));

const highlights: { value: string; label: string }[] = [
  { value: String(stats.publications), label: locale === 'ja' ? '論文' : 'Publications' },
  { value: String(stats.firstAuthor), label: locale === 'ja' ? '筆頭著者論文' : 'First-author papers' },
  { value: String(stats.peerReviewed), label: locale === 'ja' ? '査読付き論文' : 'Peer-reviewed papers' },
  { value: String(stats.hpcAllocations), label: locale === 'ja' ? '計算資源採択' : 'Compute allocations' },
];
---

<section class="hero-section relative overflow-hidden border-b hairline">
  <div
    class="hero-orb absolute -left-24 -top-32 -z-10 h-[34rem] w-[46rem] rounded-full opacity-70 pointer-events-none"
    aria-hidden="true"
    style="background: radial-gradient(circle, color-mix(in oklch, var(--accent) 20%, transparent), transparent 68%);"
  />
  <div
    class="hero-orb absolute -right-24 top-4 -z-10 h-80 w-80 rounded-full opacity-50 pointer-events-none"
    aria-hidden="true"
    style="animation-delay: -7s; background: radial-gradient(circle, color-mix(in oklch, var(--highlight) 18%, transparent), transparent 70%);"
  />

  <div class="container-page py-10 md:py-14 lg:py-16">
    <div class="grid gap-9 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-12">
      <div>
        <p class="inline-flex items-center rounded-full border border-[var(--accent)]/30 bg-[var(--accent-soft)] px-3 py-1 text-xs font-semibold tracking-wide text-[var(--accent-strong)]">
          {profile.tagline[locale]}
        </p>

        <h1 class="mt-4 font-serif text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight leading-[1.06]">
          {profile.name[locale]}
        </h1>
        {locale === 'ja' && <p class="mt-2 text-sm text-muted">{profile.reading.ja}</p>}

        <p class="mt-5 max-w-3xl text-lg sm:text-xl md:text-2xl font-medium leading-relaxed text-balance">
          {focusStatement}
        </p>

        <dl class="mt-7 max-w-3xl rounded-xl border hairline bg-[var(--bg-elev)]/90 px-4 py-2 text-sm shadow-sm">
          <div class="grid grid-cols-[4.5rem_minmax(0,1fr)] gap-3 border-b hairline py-2.5">
            <dt class="text-muted">{s.labels.position}</dt>
            <dd class="font-medium">{profile.position[locale]}</dd>
          </div>
          <div class="grid grid-cols-[4.5rem_minmax(0,1fr)] gap-3 border-b hairline py-2.5">
            <dt class="text-muted">{s.labels.affiliation}</dt>
            <dd>{profile.affiliation[locale]}</dd>
          </div>
          <div class="grid grid-cols-[4.5rem_minmax(0,1fr)] gap-3 py-2.5">
            <dt class="text-muted">{s.labels.degree}</dt>
            <dd>{profile.degree[locale]}</dd>
          </div>
        </dl>

        <a
          href={profile.researchmap}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex items-center gap-1.5 text-xs text-muted hover:text-[var(--accent-strong)] hover:underline underline-offset-4"
        >
          {s.labels.researchmapUpdated}: <time datetime={profile.researchmapUpdated}>{researchmapUpdatedLabel}</time>
          <span aria-hidden="true">↗</span>
          <span class="sr-only">{locale === 'ja' ? '（新しいタブで開きます）' : '(opens in a new tab)'}</span>
        </a>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href="#publications"
            class="inline-flex min-h-11 items-center gap-2 rounded-md bg-[var(--accent)] px-4 py-2 text-sm font-semibold text-[var(--accent-contrast)] shadow-sm transition-colors hover:bg-[var(--accent-strong)]"
          >
            {locale === 'ja' ? '主要論文を見る' : 'View selected papers'}
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="#contact"
            class="inline-flex min-h-11 items-center gap-2 rounded-md border hairline bg-[var(--bg-elev)] px-4 py-2 text-sm font-medium transition-colors hover:bg-[var(--accent-soft)]"
          >
            {s.nav.contact}
          </a>
          <a
            href={locale === 'ja' ? '/cv/' : '/en/cv/'}
            class="inline-flex min-h-11 items-center gap-1 px-2 py-2 text-sm font-medium text-[var(--accent-strong)] hover:underline underline-offset-4"
          >
            {locale === 'ja' ? '履歴書 (CV)' : 'Curriculum Vitae'}
            <span aria-hidden="true">→</span>
          </a>
        </div>

        {
          opp && (
            <a
              href="#contact"
              class="mt-5 inline-flex max-w-3xl flex-wrap items-center gap-x-2 gap-y-1 rounded-lg border border-[var(--accent)]/30 bg-[var(--accent-soft)] px-3 py-2 text-sm transition-colors hover:border-[var(--accent)]"
            >
              <span class="inline-flex items-center gap-2 font-semibold text-[var(--accent-strong)]">
                <span class="h-2 w-2 rounded-full bg-[var(--accent)]" aria-hidden="true" />
                {locale === 'ja' ? '次のポストを探しています' : 'Looking for a position'}
              </span>
              <span><strong>{opp.startFrom[locale]}</strong> — {opp.detail[locale]}</span>
            </a>
          )
        }
      </div>

      <aside class="grid gap-5 sm:grid-cols-[10rem_minmax(0,1fr)] lg:grid-cols-1 lg:self-start">
        {
          profile.portrait && (
            <div class="relative w-32 sm:w-full lg:mx-auto lg:w-48">
              <div class="absolute -inset-2 -z-10 rotate-3 rounded-2xl bg-[var(--accent-soft)]" aria-hidden="true" />
              <Portrait
                locale={locale}
                class="hero-portrait block w-full aspect-square overflow-hidden rounded-2xl border-2 border-[var(--bg-elev)] shadow-lg"
              />
            </div>
          )
        }

        {
          upcomingGroups.length > 0 && (
            <section
              id="upcoming-presentations"
              class="surface-warm p-5"
              aria-labelledby="upcoming-heading"
              data-upcoming-section
            >
              <p class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-[var(--highlight)]">
                {locale === 'ja' ? '今後の発表' : 'Upcoming'}
              </p>
              <h2 id="upcoming-heading" class="mt-2 font-serif text-lg font-semibold leading-snug">
                {upcomingHeading}
              </h2>

              <div class="mt-3 space-y-3">
                {upcomingGroups.flatMap(([, events]) => events).map((event) => (
                  <div
                    class="event-row"
                    data-event-row
                    data-event-start={event.date}
                    data-event-end={event.endDate ?? event.date}
                  >
                    <a
                      href={event.href}
                      class="event-link block rounded-lg border border-transparent px-3 py-2.5 transition-colors hover:border-[var(--highlight-border)] hover:bg-[var(--bg-elev)]"
                    >
                      <div class="flex flex-wrap items-center justify-between gap-2">
                        <time class="font-mono text-xs font-semibold tabular-nums text-[var(--highlight)]" datetime={event.date}>
                          {formatEventRange(event.date, event.endDate)}
                        </time>
                        <span
                          class="rounded-full border border-[var(--highlight-border)] bg-[var(--bg-elev)] px-2 py-0.5 text-xs font-semibold text-[var(--highlight)]"
                          data-event-status
                          data-locale={locale}
                        >
                          {locale === 'ja' ? '予定' : 'Upcoming'}
                        </span>
                      </div>
                      {event.detail && <p class="mt-1.5 text-sm leading-relaxed">{event.detail}</p>}
                      <span class="mt-1 inline-flex text-xs font-medium text-[var(--highlight)]">
                        {locale === 'ja' ? '公式情報' : 'Official details'}&nbsp;↗
                      </span>
                    </a>
                  </div>
                ))}
              </div>
            </section>
          )
        }
      </aside>
    </div>

    <dl class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-xl border hairline bg-[var(--border)] sm:grid-cols-4">
      {
        highlights.map((highlight) => (
          <div class="flex flex-col bg-[var(--bg-elev)] px-4 py-4 text-center sm:text-left">
            <dt class="mt-1 text-xs font-medium leading-tight text-muted">{highlight.label}</dt>
            <dd class="order-first font-serif text-2xl md:text-3xl font-semibold tabular-nums leading-none text-[var(--accent-strong)]">
              {highlight.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  const eventRows = Array.from(document.querySelectorAll<HTMLElement>('[data-event-row]'));
  const upcomingSection = document.querySelector<HTMLElement>('[data-upcoming-section]');
  const day = 86_400_000;
  const now = Date.now();
  let nextRow: HTMLElement | undefined;
  let nextStart = Number.POSITIVE_INFINITY;
  let visibleEvents = 0;

  for (const row of eventRows) {
    const startValue = row.dataset.eventStart;
    const endValue = row.dataset.eventEnd ?? startValue;
    if (!startValue || !endValue) continue;

    const start = new Date(`${startValue}T00:00:00+09:00`).getTime();
    const end = new Date(`${endValue}T23:59:59+09:00`).getTime();
    const status = row.querySelector<HTMLElement>('[data-event-status]');
    const locale = status?.dataset.locale ?? 'ja';

    if (now > end) {
      row.hidden = true;
      continue;
    }

    visibleEvents += 1;
    if (now >= start) {
      if (status) status.textContent = locale === 'ja' ? '開催中' : 'In progress';
    } else {
      const days = Math.max(1, Math.ceil((start - now) / day));
      if (status) {
        status.textContent = locale === 'ja'
          ? days === 1 ? '明日' : `あと${days}日`
          : days === 1 ? 'Tomorrow' : `In ${days} days`;
      }
      if (start < nextStart) {
        nextStart = start;
        nextRow = row;
      }
    }
  }

  if (nextRow) nextRow.dataset.nextEvent = 'true';
  if (upcomingSection && visibleEvents === 0) upcomingSection.hidden = true;
</script>

<style>
  .hero-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
