---
import type { Locale } from '~/data/types';
import { profile } from '~/data';
import { stats } from '~/data/stats';
import { t } from '~/i18n/ui';
import Portrait from './Portrait.astro';
import UpcomingPresentations from './UpcomingPresentations.astro';

type Props = { locale: Locale };
const { locale } = Astro.props;
const s = t(locale);

const opp = profile.openToOpportunities;
const focusStatement = locale === 'ja'
  ? '大規模言語モデルを、効率的かつ信頼できる形で事後学習・適応させる方法を研究しています。'
  : 'I study how to post-train and adapt large language models efficiently and reliably.';
const researchmapUpdatedLabel = new Intl.DateTimeFormat(locale === 'ja' ? 'ja-JP' : 'en-US', {
  year: 'numeric',
  month: locale === 'ja' ? 'numeric' : 'short',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${profile.researchmapUpdated}T00:00:00Z`));

const highlights: { value: string; label: string }[] = [
  { value: String(stats.publications), label: locale === 'ja' ? '論文' : 'Publications' },
  { value: String(stats.firstAuthor), label: locale === 'ja' ? '筆頭著者論文' : 'First-author papers' },
  { value: String(stats.peerReviewed), label: locale === 'ja' ? '査読付き論文' : 'Peer-reviewed papers' },
  { value: String(stats.hpcAllocations), label: locale === 'ja' ? '計算資源採択' : 'Compute allocations' },
];
---

<section class="hero-section relative overflow-hidden border-b hairline">
  <div
    class="hero-orb absolute -left-24 -top-32 -z-10 h-[34rem] w-[46rem] rounded-full opacity-70 pointer-events-none"
    aria-hidden="true"
    style="background: radial-gradient(circle, color-mix(in oklch, var(--accent) 20%, transparent), transparent 68%);"
  />
  <div
    class="hero-orb absolute -right-24 top-4 -z-10 h-80 w-80 rounded-full opacity-50 pointer-events-none"
    aria-hidden="true"
    style="animation-delay: -7s; background: radial-gradient(circle, color-mix(in oklch, var(--highlight) 18%, transparent), transparent 70%);"
  />

  <div class="container-page py-9 md:py-12 lg:py-14">
    <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-14">
      <div>
        <div class="flex items-start justify-between gap-5">
          <div class="min-w-0">
            <p class="inline-flex items-center rounded-full border border-[var(--accent)]/30 bg-[var(--accent-soft)] px-3 py-1 text-xs font-semibold tracking-wide text-[var(--accent-strong)]">
              {profile.tagline[locale]}
            </p>

            <h1 class="mt-4 font-serif text-4xl font-semibold leading-[1.06] tracking-tight sm:text-5xl lg:text-6xl">
              {profile.name[locale]}
            </h1>
            {locale === 'ja' && <p class="mt-2 text-sm text-muted">{profile.reading.ja}</p>}
          </div>

          {
            profile.portrait && (
              <div class="relative mt-1 w-20 shrink-0 sm:w-24 lg:hidden">
                <div class="absolute -inset-1.5 -z-10 rotate-3 rounded-2xl bg-[var(--accent-soft)]" aria-hidden="true" />
                <Portrait
                  locale={locale}
                  class="hero-portrait block aspect-square w-full overflow-hidden rounded-2xl border-2 border-[var(--bg-elev)] shadow-md"
                />
              </div>
            )
          }
        </div>

        <p class="mt-5 max-w-3xl text-lg font-semibold leading-relaxed text-balance sm:text-xl md:text-2xl">
          {focusStatement}
        </p>
      </div>

      {
        profile.portrait && (
          <aside class="relative hidden w-full lg:block">
            <div class="absolute -inset-2 -z-10 rotate-3 rounded-2xl bg-[var(--accent-soft)]" aria-hidden="true" />
            <Portrait
              locale={locale}
              class="hero-portrait block aspect-square w-full overflow-hidden rounded-2xl border-2 border-[var(--bg-elev)] shadow-lg"
            />
          </aside>
        )
      }
    </div>

    <div class="mt-8 md:mt-10">
      <UpcomingPresentations locale={locale} />
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(20rem,0.9fr)] lg:items-start lg:gap-8">
      <div>
        <dl class="rounded-xl border hairline bg-[var(--bg-elev)] px-4 py-2 text-sm shadow-sm">
          <div class="grid grid-cols-[4.5rem_minmax(0,1fr)] gap-3 border-b hairline py-2.5">
            <dt class="text-muted">{s.labels.position}</dt>
            <dd class="font-medium">{profile.position[locale]}</dd>
          </div>
          <div class="grid grid-cols-[4.5rem_minmax(0,1fr)] gap-3 border-b hairline py-2.5">
            <dt class="text-muted">{s.labels.affiliation}</dt>
            <dd>{profile.affiliation[locale]}</dd>
          </div>
          <div class="grid grid-cols-[4.5rem_minmax(0,1fr)] gap-3 py-2.5">
            <dt class="text-muted">{s.labels.degree}</dt>
            <dd>{profile.degree[locale]}</dd>
          </div>
        </dl>

        <a
          href={profile.researchmap}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex items-center gap-1.5 text-xs text-muted underline-offset-4 hover:text-[var(--accent-strong)] hover:underline"
        >
          {s.labels.researchmapUpdated}: <time datetime={profile.researchmapUpdated}>{researchmapUpdatedLabel}</time>
          <span aria-hidden="true">↗</span>
          <span class="sr-only">{locale === 'ja' ? '（新しいタブで開きます）' : '(opens in a new tab)'}</span>
        </a>
      </div>

      <div>
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="#publications"
            class="inline-flex min-h-11 items-center gap-2 rounded-md bg-[var(--accent)] px-4 py-2 text-sm font-semibold text-[var(--accent-contrast)] shadow-sm transition-colors hover:bg-[var(--accent-strong)]"
          >
            {locale === 'ja' ? '主要論文を見る' : 'View selected papers'}
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="#contact"
            class="inline-flex min-h-11 items-center gap-2 rounded-md border hairline bg-[var(--bg-elev)] px-4 py-2 text-sm font-medium transition-colors hover:bg-[var(--accent-soft)]"
          >
            {s.nav.contact}
          </a>
          <a
            href={locale === 'ja' ? '/cv/' : '/en/cv/'}
            class="inline-flex min-h-11 items-center gap-1 px-2 py-2 text-sm font-medium text-[var(--accent-strong)] underline-offset-4 hover:underline"
          >
            {locale === 'ja' ? '履歴書 (CV)' : 'Curriculum Vitae'}
            <span aria-hidden="true">→</span>
          </a>
        </div>

        {
          opp && (
            <a
              href="#contact"
              class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 rounded-lg border border-[var(--accent)]/30 bg-[var(--accent-soft)] px-3 py-2.5 text-sm transition-colors hover:border-[var(--accent)]"
            >
              <span class="inline-flex items-center gap-2 font-semibold text-[var(--accent-strong)]">
                <span class="h-2 w-2 rounded-full bg-[var(--accent)]" aria-hidden="true" />
                {locale === 'ja' ? '次のポストを探しています' : 'Looking for a position'}
              </span>
              <span><strong>{opp.startFrom[locale]}</strong> — {opp.detail[locale]}</span>
            </a>
          )
        }
      </div>
    </div>

    <dl class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-xl border hairline bg-[var(--border)] sm:grid-cols-4">
      {
        highlights.map((highlight) => (
          <div class="flex flex-col bg-[var(--bg-elev)] px-4 py-4 text-center sm:text-left">
            <dt class="mt-1 text-xs font-medium leading-tight text-muted">{highlight.label}</dt>
            <dd class="order-first font-serif text-2xl md:text-3xl font-semibold tabular-nums leading-none text-[var(--accent-strong)]">
              {highlight.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
