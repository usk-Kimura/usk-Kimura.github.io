---
import type { Locale } from '~/data/types';
import { publications } from '~/data';
import { t, fmt } from '~/i18n/ui';
import { L, localizePath } from '~/i18n/locale';
import Section from './Section.astro';
import PublicationItem from './PublicationItem.astro';

type Props = { locale: Locale };
const { locale } = Astro.props;
const s = t(locale);

const selected = publications
  .filter((p) => p.selected)
  .sort((a, b) => b.year * 12 + (b.month ?? 0) - (a.year * 12 + (a.month ?? 0)));
---

<Section id="publications" title={s.sections.selectedPublications}>
  <ol class="divided">
    {
      selected.map((pub) => (
        <li>
          <PublicationItem
            pub={pub}
            locale={locale}
            note={pub.selectedReason ? L(pub.selectedReason, locale) : undefined}
          />
        </li>
      ))
    }
  </ol>

  <p class="mt-6">
    <a href={localizePath('/publications/', locale)} class="btn">
      {s.actions.seeAllPublications}
      <span class="text-muted">{fmt(s.counts.publications, { n: publications.length })}</span>
      <span aria-hidden="true">→</span>
    </a>
  </p>
</Section>
