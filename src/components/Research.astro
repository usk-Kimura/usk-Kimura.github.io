---
import type { Locale } from '~/data/types';
import { profile } from '~/data';
import { researchAgenda } from '~/data/research';
import { t } from '~/i18n/ui';
import { L } from '~/i18n/locale';
import Section from './Section.astro';

type Props = { locale: Locale };
const { locale } = Astro.props;
const s = t(locale);
---

<Section id="research" title={s.sections.research}>
  <div class="divided">
    {
      researchAgenda.map((item) => (
        <article class="py-5 first:pt-0">
          <p class="tag">{L(item.tag, locale)}</p>
          <h3 class="mt-1 leading-snug font-semibold">{L(item.title, locale)}</h3>
          <p class="mt-1.5 text-[0.9375rem] leading-[1.9] text-muted">
            {L(item.description, locale)}
          </p>
        </article>
      ))
    }
  </div>

  <dl class="mt-8 space-y-4 text-sm">
    <div>
      <dt class="text-muted">{s.sections.keywords}</dt>
      <dd class="mt-1 leading-relaxed">
        {profile.keywords.map((k) => L(k, locale)).join(' · ')}
      </dd>
    </div>
    <div>
      <dt class="text-muted">{s.sections.fields}</dt>
      <dd class="mt-1 leading-relaxed">
        {profile.fields.map((f) => L(f, locale)).join(' · ')}
      </dd>
    </div>
  </dl>
</Section>
