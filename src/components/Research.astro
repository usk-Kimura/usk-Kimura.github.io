---
import type { Locale } from '~/data/types';
import { profile } from '~/data';
import { researchAgenda } from '~/data/research';
import { t } from '~/i18n/ui';
import { L } from '~/i18n/locale';
import Section from './Section.astro';

type Props = { locale: Locale };
const { locale } = Astro.props;
const s = t(locale);
---

<Section id="research" title={s.sections.research} home full>
  <div class="grid gap-3 md:grid-cols-3 md:gap-4">
    {
      researchAgenda.map((item) => (
        <article
          class="rounded-xl border p-5 hairline md:p-6"
          style="background: var(--bg-soft);"
        >
          <p class="tag">{L(item.tag, locale)}</p>
          <h3 class="mt-2 leading-snug font-semibold">{L(item.title, locale)}</h3>
          <p class="mt-3 text-sm leading-[1.85] text-muted">
            {L(item.description, locale)}
          </p>
        </article>
      ))
    }
  </div>

  <dl class="mt-7 grid gap-4 border-y py-4 text-sm hairline sm:grid-cols-2 sm:gap-8">
    <div>
      <dt class="text-muted">{s.sections.keywords}</dt>
      <dd class="mt-1 leading-relaxed">
        {profile.keywords.map((k) => L(k, locale)).join(' · ')}
      </dd>
    </div>
    <div>
      <dt class="text-muted">{s.sections.fields}</dt>
      <dd class="mt-1 leading-relaxed">
        {profile.fields.map((f) => L(f, locale)).join(' · ')}
      </dd>
    </div>
  </dl>
</Section>
