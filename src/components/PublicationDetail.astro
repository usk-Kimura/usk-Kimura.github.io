---
import type { Locale, Publication, SourceLocale } from '~/data/types';
import { profile } from '~/data';
import {
  bibtexEntry,
  isPdfUrl,
  parsePageRange,
  pubSlug,
  splitAuthors,
  highlightSelf,
} from '~/data/util';
import { breadcrumbJsonLd } from '~/data/jsonld';
import { t } from '~/i18n/ui';
import { L, LO, localeMeta, localizePath } from '~/i18n/locale';
import { formatYearMonth } from '~/i18n/format';
import BaseLayout from '~/layouts/BaseLayout.astro';

type Props = { pub: Publication; locale: Locale };
const { pub, locale } = Astro.props;
const s = t(locale);

const slug = pubSlug(pub);
const publicationsIndex = localizePath('/publications/', locale);

const CJK = /[　-ヿ㐀-䶿一-鿿＀-￯]/;
const titleLang: SourceLocale = pub.titleLang ?? (CJK.test(pub.title) ? 'ja' : 'en');
const useVenueEn = locale !== 'ja' && Boolean(pub.venueEn);
const venueText = useVenueEn ? pub.venueEn! : pub.venue;
const venueLang: SourceLocale = useVenueEn ? 'en' : CJK.test(pub.venue) ? 'ja' : 'en';
/** Venue string used in machine-readable output — always the Latin form if we have one. */
const venueScholar = pub.venueEn ?? pub.venue;

const authors = splitAuthors(pub.authors);
const pageRange = parsePageRange(pub.pages);

const publicationDate = pub.month
  ? `${pub.year}-${pub.month}${pub.day ? `-${pub.day}` : ''}`
  : `${pub.year}`;
const dateLabel = pub.month ? formatYearMonth(publicationDate, locale) : `${pub.year}`;
const dateIso = pub.month
  ? `${pub.year}-${String(pub.month).padStart(2, '0')}${pub.day ? `-${String(pub.day).padStart(2, '0')}` : ''}`
  : `${pub.year}`;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const externalUrl = pub.url ?? (pub.doi ? `https://doi.org/${pub.doi}` : null);
const abstract = LO(pub.abstract, locale);
// Abstracts are frequently English-only. Tag the element with the language the
// text is actually in, not the page locale, so a Korean page reading an English
// abstract is announced correctly.
const abstractLocale: Locale = pub.abstract?.[locale] ? locale : pub.abstract?.en ? 'en' : 'ja';
const abstractLang = localeMeta[abstractLocale].lang;
const pageDesc = abstract ?? `${pub.authors}. ${venueText}, ${dateLabel}.`;
---

<BaseLayout
  locale={locale}
  title={pub.title}
  description={pageDesc}
  path={`/p/${slug}/`}
  ogType="article"
>
  <Fragment slot="head">
    {/* Google Scholar citation tags */}
    <meta name="citation_title" content={pub.title} />
    {authors.map((a) => <meta name="citation_author" content={a} />)}
    <meta name="citation_publication_date" content={dateIso} />
    {pub.type === 'journal' && <meta name="citation_journal_title" content={venueScholar} />}
    {pub.type !== 'journal' && <meta name="citation_conference_title" content={venueScholar} />}
    {pageRange && <meta name="citation_firstpage" content={pageRange.first} />}
    {pageRange && <meta name="citation_lastpage" content={pageRange.last} />}
    {pub.doi && <meta name="citation_doi" content={pub.doi} />}
    {externalUrl && <meta name="citation_public_url" content={externalUrl} />}
    {isPdfUrl(externalUrl) && <meta name="citation_pdf_url" content={externalUrl} />}
    <meta name="citation_language" content={titleLang} />

    <meta property="article:published_time" content={dateIso} />
    {authors.map((a) => <meta property="article:author" content={a} />)}

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'ScholarlyArticle',
        headline: pub.title,
        name: pub.title,
        author: authors.map((a) => ({ '@type': 'Person', name: a })),
        datePublished: dateIso,
        ...(pub.type === 'journal'
          ? { isPartOf: { '@type': 'PublicationVolume', name: venueScholar } }
          : { publisher: { '@type': 'Organization', name: venueScholar } }),
        ...(pub.doi && { sameAs: `https://doi.org/${pub.doi}` }),
        ...(pub.pages && { pagination: pub.pages }),
        ...(abstract && { abstract }),
        url: canonicalUrl,
        inLanguage: titleLang,
      })}
    />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbJsonLd(locale, pub.title, canonicalUrl, Astro.site!))}
    />
  </Fragment>

  <article class="container-page py-10 md:py-14">
    <nav aria-label={s.labels.breadcrumb} class="text-sm text-muted">
      <a href={localizePath('/', locale)} class="link-quiet">{L(profile.name, locale)}</a>
      <span aria-hidden="true"> / </span>
      <a href={publicationsIndex} class="link-quiet">{s.sections.publications}</a>
    </nav>

    <p class="mt-6 text-sm text-muted">
      {s.pubTypes[pub.type]}
      <span aria-hidden="true"> · </span>
      <time datetime={dateIso}>{dateLabel}</time>
    </p>

    <h1
      class="mt-2 text-2xl leading-tight font-bold tracking-tight md:text-3xl"
      lang={titleLang}
    >
      {pub.title}
    </h1>

    <p class="mt-4 text-muted" set:html={highlightSelf(pub.authors)} />
    <p class="text-muted">
      <em lang={venueLang}>{venueText}</em>{pub.pages ? `, ${pub.pages}` : ''}
    </p>

    {
      pub.flags && pub.flags.length > 0 && (
        <ul class="flagset mt-3">
          {pub.flags.map((f) => (
            <li>{s.flags[f]}</li>
          ))}
        </ul>
      )
    }

    {
      abstract && (
        <section class="mt-8">
          <h2 class="text-sm font-semibold text-muted">{s.labels.abstract}</h2>
          <p class="mt-2 leading-[1.9]" lang={abstractLang}>{abstract}</p>
        </section>
      )
    }

    <div class="mt-8 flex flex-wrap gap-2">
      {
        externalUrl && (
          <a
            href={externalUrl}
            target="_blank"
            rel="noopener noreferrer external"
            class="btn btn-primary"
          >
            {pub.doi ? 'DOI' : s.labels.external}
            <span aria-hidden="true">↗</span>
            <span class="sr-only">{s.labels.newTab}</span>
          </a>
        )
      }
      <a href={publicationsIndex} class="btn">
        <span aria-hidden="true">←</span>
        {s.actions.backToPublications}
      </a>
    </div>

    <section class="mt-10 border-t hairline pt-6">
      <h2 class="text-sm font-semibold text-muted">BibTeX</h2>
      <pre
        class="mt-2 overflow-x-auto rounded-md border hairline p-4 font-mono text-xs leading-relaxed"
        style="background: var(--bg-soft);">{bibtexEntry(pub, venueScholar)}</pre>
    </section>
  </article>
</BaseLayout>
