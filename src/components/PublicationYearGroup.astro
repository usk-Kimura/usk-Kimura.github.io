---
import type { Locale, Publication } from '~/data/types';
import { L } from '~/i18n/locale';
import { publicationAwardsFor } from '~/data/relations';
import PublicationItem from './PublicationItem.astro';

type Props = {
  year: number;
  items: Publication[];
  locale: Locale;
  headingLevel?: 2 | 3;
  itemHeadingLevel?: 3 | 4;
};

const { year, items, locale, headingLevel = 2, itemHeadingLevel = 3 } = Astro.props;
const Heading = headingLevel === 3 ? 'h3' : 'h2';
---

<section data-output-group data-year={year} aria-labelledby={`year-${year}`}>
  <Heading
    id={`year-${year}`}
    class="sticky z-10 border-b hairline py-1.5 text-sm font-semibold tabular-nums"
    style="top: var(--header-h); background: color-mix(in oklch, var(--bg) 92%, transparent); backdrop-filter: blur(6px);"
  >
    {year}
  </Heading>
  <ol class="divided">
    {
      items.map((pub) => {
        const publicationAwards = publicationAwardsFor(pub);
        const awardSearch = publicationAwards
          .map((award) => `${L(award.name, locale)} ${L(award.organization, locale)} ${award.recipients}`)
          .join(' ');
        const coauthorAwardSearch =
          pub.coauthorAwards
            ?.map((award) => `${L(award.name, locale)} ${award.recipient}`)
            .join(' ') ?? '';
        return (
          <li
            data-output-item
            data-output-type={pub.type}
            data-output-search={`${pub.title} ${pub.authors} ${pub.venue} ${pub.venueEn ?? ''} ${pub.year} ${awardSearch} ${coauthorAwardSearch}`}
          >
            <PublicationItem pub={pub} locale={locale} headingLevel={itemHeadingLevel} />
          </li>
        );
      })
    }
  </ol>
</section>
