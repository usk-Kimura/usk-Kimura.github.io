---
import type { Locale, Publication } from '~/data/types';
import PublicationItem from './PublicationItem.astro';

type Props = {
  year: number;
  items: Publication[];
  locale: Locale;
};

const { year, items, locale } = Astro.props;
---

<section class="pub-year-group" data-pub-year-group data-year={year} aria-labelledby={`year-${year}`}>
  <header
    class="sticky z-10 -mx-4 sm:-mx-5 md:-mx-8 px-4 sm:px-5 md:px-8 py-2 backdrop-blur-md border-b hairline"
    style="top: var(--site-header-offset); background: color-mix(in oklch, var(--bg) 86%, transparent);"
  >
    <h3
      id={`year-${year}`}
      class="font-mono text-sm font-semibold tabular-nums tracking-wider text-[var(--accent)]"
    >
      {year}
    </h3>
  </header>
  <div class="surface px-4 sm:px-5 md:px-8 py-1 mt-3">
    {
      items.map((pub, i) => (
        <div
          data-pub-item
          data-pub-type={pub.type}
          data-pub-search={`${pub.title} ${pub.authors} ${pub.venue} ${pub.venueEn ?? ''} ${pub.year}`}
          class:list={['hairline', i < items.length - 1 && 'border-b']}
        >
          <PublicationItem pub={pub} locale={locale} />
        </div>
      ))
    }
  </div>
</section>
