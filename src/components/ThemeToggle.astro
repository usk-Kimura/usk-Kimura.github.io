---
import type { Locale } from '~/data/types';
import { t } from '~/i18n/ui';

type Props = { locale: Locale };
const { locale } = Astro.props;
const label = t(locale).labels.toggleTheme;
---

<button
  type="button"
  id="theme-toggle"
  class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-md border hairline hover:bg-[var(--bg-soft)]"
  aria-label={label}
  aria-pressed="false"
  title={label}
>
  <svg
    class="theme-icon-light h-4 w-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
  <svg
    class="theme-icon-dark h-4 w-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  // Which icon shows is handled entirely in CSS (see global.css), so the button
  // is already correct on the first frame and stays correct without JS.
  // This script only owns the toggle, `aria-pressed`, and the browser chrome
  // colour, which cannot be expressed declaratively.
  const btn = document.getElementById('theme-toggle') as HTMLButtonElement | null;
  const root = document.documentElement;
  const lightMeta = document.getElementById('theme-color-light');
  const darkMeta = document.getElementById('theme-color-dark');

  const COLORS = { light: '#ffffff', dark: '#15171b' } as const;

  function currentTheme(): 'light' | 'dark' {
    if (root.dataset.theme === 'light' || root.dataset.theme === 'dark') return root.dataset.theme;
    return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function stored(): string | null {
    try {
      return localStorage.getItem('theme');
    } catch {
      return null;
    }
  }

  function sync() {
    const theme = currentTheme();
    btn?.setAttribute('aria-pressed', String(theme === 'dark'));
    // Pin both <meta name="theme-color"> tags to the active theme so mobile
    // browser chrome follows the in-page toggle, not just the OS setting.
    if (lightMeta && darkMeta) {
      const explicit = root.dataset.theme === 'light' || root.dataset.theme === 'dark';
      if (explicit) {
        lightMeta.setAttribute('content', COLORS[theme]);
        darkMeta.setAttribute('content', COLORS[theme]);
      }
    }
  }

  sync();

  btn?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* private mode — the choice just won't persist */
    }
    sync();
  });

  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (!stored()) sync();
  });
</script>
