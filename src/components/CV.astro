---
import type { Locale, SourceLocale } from '~/data/types';
import {
  profile,
  career,
  education,
  awards,
  publications,
  grantCategoryOrder,
  grants,
  memberships,
  services,
} from '~/data';
import { highlightSelf } from '~/data/util';
import { publicationAwardsFor } from '~/data/relations';
import { t } from '~/i18n/ui';
import { L, localizePath } from '~/i18n/locale';
import { formatAmountJpy, formatRangeParts, formatYearMonth, isoYearMonth } from '~/i18n/format';

type Props = { locale: Locale };
const { locale } = Astro.props;
const s = t(locale);

const sortedPubs = [...publications].sort(
  (a, b) => b.year * 12 + (b.month ?? 0) - (a.year * 12 + (a.month ?? 0)),
);

const CJK = /[　-ヿ㐀-䶿一-鿿＀-￯]/;

// ORCID is rendered explicitly in the header block, so drop it from the links.
const cvLinks = profile.links.filter(
  (l) => !l.social && !l.href.startsWith('https://orcid.org/'),
);

const TYPE_ORDER = ['journal', 'international-conference', 'domestic-conference'] as const;
const pubsByType = TYPE_ORDER.map((type) => ({
  type,
  items: sortedPubs.filter((p) => p.type === type),
})).filter((g) => g.items.length > 0);

const grantsByCategory = grantCategoryOrder.map((category) => ({
  category,
  items: grants.filter((grant) => grant.category === category),
})).filter((group) => group.items.length > 0);

function range(start: string, end?: string) {
  return formatRangeParts(start, end, locale, s.labels.present);
}

const name = L(profile.name, locale);
const reading = L(profile.reading, locale);
---

<div class="cv-toolbar no-print">
  <div class="container-wide flex flex-wrap items-center gap-2 py-3">
    <a href={localizePath('/', locale)} class="link-quiet text-sm">
      <span aria-hidden="true">←</span>
      {s.actions.backHome}
    </a>
    <button type="button" id="cv-print" class="btn ml-auto h-8 min-h-8 text-xs">
      {s.labels.print}
    </button>
  </div>
</div>

<article class="cv container-wide py-8 print:py-0">
  <header class="cv-header">
    <div class="min-w-0 flex-1">
      <h1 class="cv-name">{name}</h1>
      {reading !== name && <p class="cv-reading">{reading}</p>}
      <p class="cv-tagline">{L(profile.tagline, locale)}</p>
    </div>
    {
      profile.portrait && (
        <picture class="cv-portrait">
          <source type="image/avif" srcset="/portrait-480.avif 480w" sizes="120px" />
          <source type="image/webp" srcset="/portrait-480.webp 480w" sizes="120px" />
          <img
            src="/portrait-480.jpg"
            alt={L(profile.portrait.alt, locale)}
            width="120"
            height="120"
            loading="eager"
          />
        </picture>
      )
    }
  </header>

  <dl class="cv-meta">
    <dt>{s.labels.affiliation}</dt>
    <dd>{L(profile.affiliation, locale)} — {L(profile.position, locale)}</dd>
    <dt>{s.labels.degree}</dt>
    <dd>{L(profile.degree, locale)}</dd>
    <dt>{s.labels.email}</dt>
    <dd>
      {
        profile.emails.map((e, i) => (
          <span>
            {i > 0 && ' / '}
            <a href={`mailto:${e.address}`}>{e.address}</a>
            <span class="cv-note"> ({L(e.label, locale)})</span>
          </span>
        ))
      }
    </dd>
    <dt>ORCID</dt>
    <dd><a href={`https://orcid.org/${profile.orcid}`}>{profile.orcid}</a></dd>
    <dt>{s.cv.researcherNumber}</dt>
    <dd>{profile.identifiers.researcherNumber}</dd>
    <dt>J-GLOBAL ID</dt>
    <dd>
      <a href={`https://jglobal.jst.go.jp/detail?JGLOBAL_ID=${profile.identifiers.jGlobalId}`}>
        {profile.identifiers.jGlobalId}
      </a>
    </dd>
    <dt>{s.cv.researchmapMemberId}</dt>
    <dd>{profile.identifiers.researchmapMemberId}</dd>
    {
      cvLinks.map((l) => (
        <Fragment>
          <dt>{L(l.label, locale)}</dt>
          <dd>
            <a href={l.href}>{l.href}</a>
          </dd>
        </Fragment>
      ))
    }
  </dl>

  <section class="cv-section">
    <h2>{s.sections.education}</h2>
    <ol class="cv-list">
      {
        education.map((e) => {
          const parts = range(e.start, e.end);
          return (
            <li>
              <span class="cv-date">
                {parts.start} – {parts.end}
              </span>
              <span>
                <strong>{L(e.program, locale)}</strong>, {L(e.school, locale)}
              </span>
            </li>
          );
        })
      }
    </ol>
  </section>

  <section class="cv-section">
    <h2>{s.sections.career}</h2>
    <ol class="cv-list">
      {
        career.map((c) => {
          const parts = range(c.start, c.end);
          return (
            <li>
              <span class="cv-date">
                {parts.start} – {parts.end}
              </span>
              <span>
                <strong>{L(c.role, locale)}</strong>, {L(c.organization, locale)}
              </span>
            </li>
          );
        })
      }
    </ol>
  </section>

  <section class="cv-section">
    <h2>{s.sections.awards}</h2>
    <ol class="cv-list">
      {
        awards.map((a) => (
          <li>
            <time class="cv-date" datetime={isoYearMonth(a.date)}>
              {formatYearMonth(a.date, locale)}
            </time>
            <span>
              <strong>{L(a.name, locale)}</strong>, {L(a.organization, locale)}
              <br />
              <span class="cv-note">{L(a.work, locale)}</span>
              {a.context && (
                <Fragment>
                  <br />
                  <span class="cv-note">{L(a.context, locale)}</span>
                </Fragment>
              )}
            </span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="cv-section">
    <h2>
      {s.sections.publications} <span class="cv-note">({sortedPubs.length})</span>
    </h2>
    {
      pubsByType.map((group) => (
        <div class="cv-pub-group">
          <h3>{s.pubTypes[group.type]}</h3>
          <ol class="cv-pubs">
            {group.items.map((pub) => {
              const publicationAwards = publicationAwardsFor(pub);
              const titleLang: SourceLocale =
                pub.titleLang ?? (CJK.test(pub.title) ? 'ja' : 'en');
              const useVenueEn = locale !== 'ja' && Boolean(pub.venueEn);
              const venueText = useVenueEn ? pub.venueEn! : pub.venue;
              const venueLang: SourceLocale = useVenueEn
                ? 'en'
                : CJK.test(pub.venue)
                  ? 'ja'
                  : 'en';
              const publicationDate = pub.month
                ? `${pub.year}-${pub.month}${pub.day ? `-${pub.day}` : ''}`
                : String(pub.year);
              const dateLabel = pub.month
                ? formatYearMonth(publicationDate, locale)
                : String(pub.year);
              return (
                <li>
                  <span set:html={highlightSelf(pub.authors)} />
                  {'. '}
                  <span class="cv-pub-title" lang={titleLang}>
                    {pub.title}
                  </span>
                  {'. '}
                  <em lang={venueLang}>{venueText}</em>
                  {pub.pages ? `, ${pub.pages}` : ''}, {dateLabel}.
                  {pub.flags && pub.flags.length > 0 && (
                    <span class="cv-note">
                      {pub.flags.map((f) => ` [${s.flags[f]}]`).join('')}
                    </span>
                  )}
                  {publicationAwards.map((award) => (
                    <Fragment>
                      <br />
                      <span class="cv-note">
                        [{s.labels.publicationAward}:{' '}
                        {award.link ? (
                          <a href={award.link.href}>{L(award.name, locale)}</a>
                        ) : (
                          L(award.name, locale)
                        )}]
                      </span>
                    </Fragment>
                  ))}
                  {pub.coauthorAwards?.map((award) => (
                    <Fragment>
                      <br />
                      <span class="cv-note">
                        [{s.labels.coauthorAward}:{' '}
                        {award.url ? (
                          <a href={award.url}>{L(award.name, locale)}</a>
                        ) : (
                          L(award.name, locale)
                        )}
                        {' — '}{s.labels.recipient}:{' '}
                        {award.recipientUrl ? (
                          <a href={award.recipientUrl}>{award.recipient}</a>
                        ) : (
                          award.recipient
                        )}]
                      </span>
                    </Fragment>
                  ))}
                </li>
              );
            })}
          </ol>
        </div>
      ))
    }
  </section>

  <section class="cv-section">
    <h2>{s.sections.grants}</h2>
    {
      grantsByCategory.map((group) => (
        <div class="cv-support-group">
          <h3>
            {s.grantCategories[group.category]} <span class="cv-note">({group.items.length})</span>
          </h3>
          <ol class="cv-list">
            {group.items.map((g) => {
              const parts = range(g.start, g.end);
              const facts = [
                g.number ? `${s.labels.projectNumber} ${g.number}` : null,
                g.amountJpy ? `${s.labels.amount} ${formatAmountJpy(g.amountJpy, locale)}` : null,
                g.role ? L(g.role, locale) : null,
              ].filter(Boolean) as string[];
              return (
                <li>
                  <span class="cv-date">
                    {parts.start} – {parts.end}
                  </span>
                  <span>
                    <strong>{L(g.title, locale)}</strong>
                    <br />
                    <span class="cv-note">{L(g.funder, locale)}</span>
                    {facts.length > 0 && <span class="cv-note"> [{facts.join(' / ')}]</span>}
                  </span>
                </li>
              );
            })}
          </ol>
        </div>
      ))
    }
  </section>

  <section class="cv-section">
    <h2>{s.sections.services}</h2>
    <ol class="cv-list">
      {
        services.map((sv) => {
          const parts = range(sv.start, sv.end);
          const singleDate = sv.end === sv.start;
          return (
            <li>
              <span class="cv-date">
                {parts.start}{!singleDate && ` – ${parts.end}`}
              </span>
              <span>
                <strong>{L(sv.title, locale)}</strong>
                {sv.organization && (
                  <Fragment>
                    <br />
                    <span class="cv-note">{L(sv.organization, locale)}</span>
                  </Fragment>
                )}
              </span>
            </li>
          );
        })
      }
    </ol>
  </section>

  <section class="cv-section">
    <h2>{s.sections.memberships}</h2>
    <ol class="cv-list">
      {
        memberships.map((m) => {
          const parts = range(m.start, m.end);
          return (
            <li>
              <span class="cv-date">
                {parts.start} – {parts.end}
              </span>
              <span>
                <strong>{L(m.organization, locale)}</strong>
              </span>
            </li>
          );
        })
      }
    </ol>
  </section>

  <footer class="cv-footer">
    <p>
      {s.labels.researchmapUpdated}:
      <time datetime={profile.researchmapUpdated}>{profile.researchmapUpdated}</time>
    </p>
  </footer>
</article>

<script>
  document.getElementById('cv-print')?.addEventListener('click', () => window.print());
</script>

<style>
  .cv {
    line-height: 1.6;
  }

  .cv-toolbar {
    position: sticky;
    top: var(--header-h);
    z-index: 20;
    border-bottom: 1px solid var(--border);
    background: color-mix(in oklch, var(--bg) 90%, transparent);
    backdrop-filter: blur(8px);
  }

  .cv-header {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .cv-name {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }
  .cv-reading {
    margin-top: 0.2rem;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }
  .cv-tagline {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }

  .cv-portrait {
    flex-shrink: 0;
    width: 96px;
    height: 96px;
    overflow: hidden;
    border-radius: 9999px;
    border: 1px solid var(--border);
  }
  .cv-portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cv-meta {
    margin-top: 1.25rem;
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 0.2rem 1rem;
    font-size: 0.875rem;
  }
  .cv-meta dt {
    color: var(--fg-muted);
    padding-top: 0.1rem;
  }
  .cv-meta dd {
    overflow-wrap: anywhere;
  }
  .cv-meta a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--border-strong);
  }

  .cv-note {
    color: var(--fg-muted);
    font-size: 0.8125rem;
  }

  .cv-section {
    margin-top: 2rem;
  }
  .cv-section > h2 {
    font-size: 1.0625rem;
    font-weight: 600;
    padding-bottom: 0.3rem;
    margin-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
    break-after: avoid-page;
  }
  .cv-pub-group > h3,
  .cv-support-group > h3 {
    margin: 1rem 0 0.4rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--fg-muted);
    break-after: avoid-page;
  }

  .cv-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .cv-list > li,
  .cv-pubs > li,
  .cv-pub-group,
  .cv-support-group {
    break-inside: avoid-page;
  }
  .cv-list > li {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    font-size: 0.9rem;
  }
  .cv-date {
    color: var(--fg-muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  .cv-pubs {
    list-style: decimal;
    padding-left: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .cv-pubs > li {
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .cv-pub-title {
    font-weight: 500;
  }

  .cv-footer {
    margin-top: 2.5rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border);
    color: var(--fg-muted);
    font-size: 0.75rem;
  }

  @media (max-width: 639px) {
    .cv-header {
      gap: 1rem;
    }
    .cv-portrait {
      width: 76px;
      height: 76px;
    }
    .cv-meta,
    .cv-list > li {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
    .cv-meta dt {
      margin-top: 0.6rem;
      padding-top: 0;
    }
    .cv-meta dt:first-child {
      margin-top: 0;
    }
  }

  @media print {
    @page {
      size: A4;
      margin: 16mm 14mm;
    }
    :root {
      --bg: #ffffff;
      --fg: #111111;
      --fg-muted: #555555;
      --border: #cccccc;
      --border-strong: #999999;
    }
    body {
      background: #ffffff !important;
    }
    .cv {
      max-width: none;
      padding: 0 !important;
      font-size: 10pt;
      line-height: 1.45;
    }
    .cv-name {
      font-size: 21pt;
    }
    .cv-tagline {
      font-size: 10.5pt;
    }
    .cv-meta {
      font-size: 9pt;
      grid-template-columns: 6rem 1fr;
    }
    .cv-section > h2 {
      font-size: 12.5pt;
      margin-top: 1.1rem;
    }
    .cv-list {
      gap: 0.3rem;
    }
    .cv-list > li {
      font-size: 9.5pt;
      grid-template-columns: 7rem 1fr;
    }
    .cv-pubs > li {
      font-size: 9pt;
    }
    .cv-date {
      font-size: 9pt;
    }
    a {
      color: inherit;
      text-decoration: none;
    }
    .cv-portrait {
      width: 72px;
      height: 72px;
    }
  }
</style>
