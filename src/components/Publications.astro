---
import type { Locale, PublicationType } from '~/data/types';
import { publications } from '~/data';
import { t, fmt } from '~/i18n/ui';
import Section from './Section.astro';
import PublicationYearGroup from './PublicationYearGroup.astro';

type Props = { locale: Locale };
const { locale } = Astro.props;
const s = t(locale);

const sorted = [...publications].sort(
  (a, b) => b.year * 12 + (b.month ?? 0) - (a.year * 12 + (a.month ?? 0)),
);

const groups = sorted.reduce<Map<number, typeof sorted>>((acc, pub) => {
  if (!acc.has(pub.year)) acc.set(pub.year, []);
  acc.get(pub.year)!.push(pub);
  return acc;
}, new Map());

// Conventional academic ordering; only categories that actually occur.
const TYPE_ORDER: PublicationType[] = ['journal', 'international-conference', 'domestic-conference'];
const types = TYPE_ORDER.filter((tp) => sorted.some((p) => p.type === tp));

const groupEntries = Array.from(groups.entries());
const latestYear = groupEntries[0]?.[0] ?? new Date().getFullYear();
const recentGroups = groupEntries.filter(([year]) => year >= latestYear - 2);
const olderGroups = groupEntries.filter(([year]) => year < latestYear - 2);
const olderCount = olderGroups.reduce((sum, [, items]) => sum + items.length, 0);
---

<Section
  id="publications"
  title={s.sections.publications}
  level={1}
  meta={fmt(s.counts.publications, { n: publications.length })}
>
  {/* Search and filtering are entirely client-side, so they stay hidden until
      the document is marked as scripted — a dead search box is worse than none.
      The full list below is always rendered. */}
  <div class="js-only flex flex-col gap-3">
    <label class="block">
      <span class="sr-only">{s.labels.search}</span>
      <input
        id="publication-search"
        type="search"
        placeholder={s.labels.searchPlaceholder}
        autocomplete="off"
        aria-controls="publication-list"
        class="min-h-10 w-full rounded-md border hairline px-3 text-base sm:text-sm placeholder:text-muted focus:border-[var(--accent)]"
        style="background: var(--bg);"
      />
    </label>

    <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-sm" role="group" aria-label={s.labels.filter}>
      <span class="text-muted">{s.labels.filter}</span>
      <button
        type="button"
        class="pub-filter link-quiet aria-pressed:font-semibold aria-pressed:text-[var(--accent-strong)]"
        data-filter="all"
        aria-pressed="true"
        aria-controls="publication-list"
      >
        {s.labels.all}
      </button>
      {
        types.map((tp) => (
          <button
            type="button"
            class="pub-filter link-quiet aria-pressed:font-semibold aria-pressed:text-[var(--accent-strong)]"
            data-filter={tp}
            aria-pressed="false"
            aria-controls="publication-list"
          >
            {s.pubTypes[tp]}
          </button>
        ))
      }
    </div>

    {/* Always in the DOM and never `hidden`: a live region that starts out
        display:none is not reliably announced when it later appears. It simply
        holds no text until a filter is applied. */}
    <p id="publication-count" class="min-h-5 text-sm text-muted" aria-live="polite" role="status"></p>
  </div>

  <div id="publication-list" class="mt-7 space-y-8">
    {
      recentGroups.map(([year, items]) => (
        <PublicationYearGroup year={year} items={items} locale={locale} />
      ))
    }

    {
      olderGroups.length > 0 && (
        <details id="older-publications" class="group">
          <summary class="cursor-pointer list-none text-sm select-none [&::-webkit-details-marker]:hidden">
            <span class="link-quiet inline-flex items-center gap-1.5">
              <span aria-hidden="true" class="inline-block transition-transform group-open:rotate-90">
                ›
              </span>
              {s.labels.olderPublications}
              <span id="older-publication-count" class="tabular-nums">
                ({olderCount})
              </span>
            </span>
          </summary>
          <div class="mt-6 space-y-8">
            {olderGroups.map(([year, items]) => (
              <PublicationYearGroup year={year} items={items} locale={locale} />
            ))}
          </div>
        </details>
      )
    }

    <p id="publication-empty" class="hidden py-8 text-center text-muted">{s.labels.noResults}</p>
  </div>
</Section>

<script is:inline define:vars={{ matchTemplate: s.counts.matching }}>
  const buttons = document.querySelectorAll('.pub-filter');
  const items = Array.from(document.querySelectorAll('[data-pub-item]'));
  const groups = document.querySelectorAll('[data-pub-year-group]');
  const search = document.getElementById('publication-search');
  const count = document.getElementById('publication-count');
  const empty = document.getElementById('publication-empty');
  const older = document.getElementById('older-publications');
  const olderCount = document.getElementById('older-publication-count');
  let activeFilter = 'all';

  const normalize = (value) => value.normalize('NFKC').toLocaleLowerCase();

  function applyFilters(updateUrl = false) {
    const query = normalize(search?.value.trim() ?? '');
    const filtering = query.length > 0 || activeFilter !== 'all';
    let visibleCount = 0;

    for (const item of items) {
      const typeMatch = activeFilter === 'all' || item.dataset.pubType === activeFilter;
      const textMatch = query.length === 0 || normalize(item.dataset.pubSearch ?? '').includes(query);
      const match = typeMatch && textMatch;
      item.hidden = !match;
      if (match) visibleCount += 1;
    }

    for (const group of groups) {
      const visible = Array.from(group.querySelectorAll('[data-pub-item]')).filter((i) => !i.hidden);
      group.hidden = visible.length === 0;
      // Keep the hairline rules attached to the first *visible* row.
      visible.forEach((item, index) => item.classList.toggle('rule-none', index === 0));
    }

    if (older) {
      const matches = older.querySelectorAll('[data-pub-item]:not([hidden])').length;
      if (olderCount) olderCount.textContent = `(${matches})`;
      older.hidden = matches === 0;
      if (filtering && matches > 0) older.open = true;
    }

    if (count) {
      count.textContent = filtering
        ? matchTemplate.replace('{n}', String(visibleCount)).replace('{m}', String(items.length))
        : '';
    }
    empty?.classList.toggle('hidden', visibleCount !== 0);

    if (updateUrl) {
      const params = new URLSearchParams(location.search);
      if (query) params.set('q', search?.value.trim() ?? '');
      else params.delete('q');
      if (activeFilter !== 'all') params.set('type', activeFilter);
      else params.delete('type');
      history.replaceState(null, '', `${location.pathname}${params.size ? `?${params}` : ''}${location.hash}`);
    }
  }

  for (const btn of buttons) {
    btn.addEventListener('click', () => {
      activeFilter = btn.dataset.filter ?? 'all';
      for (const b of buttons) b.setAttribute('aria-pressed', String(b === btn));
      applyFilters(true);
    });
  }

  search?.addEventListener('input', () => applyFilters(true));
  search?.addEventListener('search', () => applyFilters(true));

  const params = new URLSearchParams(location.search);
  const initialQuery = params.get('q');
  const initialFilter = params.get('type');
  if (search && initialQuery) search.value = initialQuery;
  if (initialFilter) {
    const target = Array.from(buttons).find((b) => b.dataset.filter === initialFilter);
    if (target) {
      activeFilter = initialFilter;
      for (const b of buttons) b.setAttribute('aria-pressed', String(b === target));
    }
  }
  if (initialQuery || initialFilter) applyFilters();
</script>
