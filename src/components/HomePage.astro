---
import type { Locale } from '~/data/types';
import Intro from './Intro.astro';
import Highlights from './Highlights.astro';
import Activity from './Activity.astro';
import Research from './Research.astro';
import DoctoralThesis from './DoctoralThesis.astro';
import Awards from './Awards.astro';
import Career from './Career.astro';
import Teaching from './Teaching.astro';
import Grants from './Grants.astro';
import AcademicActivities from './AcademicActivities.astro';
import Contact from './Contact.astro';

/** The home page body, shared by every locale's route. */
type Props = { locale: Locale };
const { locale } = Astro.props;
---

<Intro locale={locale} />
<Highlights locale={locale} />
<Activity locale={locale} />
<Research locale={locale} />
<DoctoralThesis locale={locale} home />
<Awards locale={locale} />
<Grants locale={locale} />
<Career locale={locale} />
<Teaching locale={locale} />
<AcademicActivities locale={locale} />
<Contact locale={locale} />
