---
type Props = {
  id: string;
  eyebrow?: string;
  title: string;
  description?: string;
  count?: number;
  countLabel?: string;
  class?: string;
};
const { id, eyebrow, title, description, count, countLabel, class: extra = '' } = Astro.props;
---

<section id={id} class={`border-t hairline py-14 md:py-16 lg:py-20 ${extra}`}>
  <div class="container-page">
    <header class="mb-8 md:mb-10 max-w-3xl">
      {
        eyebrow && (
          <p aria-hidden="true" class="text-xs font-mono uppercase tracking-[0.18em] text-[var(--accent)] mb-2">
            {eyebrow}
          </p>
        )
      }
      <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-semibold tracking-tight leading-tight text-balance">
        {title}
        {
          typeof count === 'number' && (
            <span class="ml-3 text-base font-sans font-normal text-muted align-middle">
              {count}
              {countLabel ? ` ${countLabel}` : ''}
            </span>
          )
        }
      </h2>
      {description && <p class="mt-3 text-muted leading-relaxed">{description}</p>}
    </header>
    <slot />
  </div>
</section>
