---
import type { Locale } from '~/data/types';
import { profile } from '~/data';
import { t } from '~/i18n/ui';

type Props = { locale: Locale };
const { locale } = Astro.props;
const s = t(locale);
const now = new Date();
const year = now.getFullYear();
const updated = profile.researchmapUpdated;
const footerLinks = profile.links.filter((l) =>
  ['Google Scholar', 'ORCID', 'researchmap'].includes(l.label.en),
);
---

<footer class="border-t hairline print:hidden">
  <div class="container-page py-10 grid gap-4 md:grid-cols-2 md:items-end">
    <div>
      <p class="text-sm text-muted">© {year} {profile.name[locale]}</p>
      <p class="mt-1 text-xs text-muted">
        <a
          href={profile.researchmap}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[var(--fg)] hover:underline underline-offset-4"
        >
          {locale === 'ja' ? 'researchmap 最終更新' : 'researchmap last updated'}:
          <time datetime={updated}>{updated}</time>
          <span aria-hidden="true"> ↗</span>
          <span class="sr-only">{locale === 'ja' ? '（新しいタブで開きます）' : '(opens in a new tab)'}</span>
        </a>
      </p>
    </div>
    <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm md:justify-end">
      <a
        href={locale === 'ja' ? '/cv' : '/en/cv'}
        class="text-muted hover:text-[var(--fg)] underline-offset-4 hover:underline"
      >
        {locale === 'ja' ? '履歴書 (CV)' : 'Curriculum Vitae'}
      </a>
      {
        footerLinks.map((l) => (
          <a
            href={l.href}
            target="_blank"
            rel="noreferrer me"
            class="text-muted hover:text-[var(--fg)] underline-offset-4 hover:underline"
          >
            {l.label[locale]}
            <span class="sr-only">{locale === 'ja' ? '（新しいタブで開きます）' : '(opens in a new tab)'}</span>
          </a>
        ))
      }
      <a href="#main" class="text-muted hover:text-[var(--fg)] underline-offset-4 hover:underline">
        ↑ {s.labels.backToTop}
      </a>
    </div>
  </div>
</footer>

<button
  id="back-to-top"
  type="button"
  data-visible="false"
  class="fixed bottom-5 right-5 z-30 inline-flex h-11 w-11 translate-y-2 items-center justify-center rounded-full bg-[var(--accent)] text-lg font-semibold text-[var(--accent-contrast)] opacity-0 shadow-lg pointer-events-none transition-[opacity,transform,background-color] hover:bg-[var(--accent-strong)] print:hidden"
  aria-label={locale === 'ja' ? 'ページ上部へ戻る' : 'Back to top'}
  title={locale === 'ja' ? 'ページ上部へ戻る' : 'Back to top'}
>
  <span aria-hidden="true">↑</span>
</button>

<script>
  const backToTop = document.getElementById('back-to-top');
  let topButtonFrame = 0;

  function updateTopButton() {
    topButtonFrame = 0;
    if (backToTop) backToTop.dataset.visible = String(window.scrollY > window.innerHeight * 0.75);
  }

  addEventListener('scroll', () => {
    if (topButtonFrame) return;
    topButtonFrame = requestAnimationFrame(updateTopButton);
  }, { passive: true });
  updateTopButton();

  backToTop?.addEventListener('click', () => {
    scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
