---
import type { Locale } from '~/data/types';
import { profile } from '~/data';
import { t } from '~/i18n/ui';
import { L, localizePath, isMachineTranslated } from '~/i18n/locale';

type Props = { locale: Locale };
const { locale } = Astro.props;
const s = t(locale);

const year = new Date().getFullYear();
const links = profile.links.filter((l) =>
  ['Google Scholar', 'ORCID', 'researchmap'].includes(l.label.en),
);
---

<footer class="border-t hairline no-print">
  <div class="container-page py-9">
    <nav aria-label={s.labels.footerNav} class="flex flex-wrap gap-x-4 gap-y-1.5 text-sm">
      <a href={localizePath('/cv/', locale)} class="link-quiet">{s.actions.viewCv}</a>
      {
        links.map((l) => (
          <a href={l.href} target="_blank" rel="noreferrer me" class="link-quiet">
            {L(l.label, locale)}
            <span class="sr-only">{s.labels.newTab}</span>
          </a>
        ))
      }
      <a href="#top" class="link-quiet">{s.labels.backToTop}</a>
    </nav>

    <p class="mt-5 text-xs text-muted">
      © {year} {L(profile.name, locale)}
      <span aria-hidden="true"> · </span>
      <a href={profile.researchmap} target="_blank" rel="noopener noreferrer" class="link">
        {s.labels.researchmapUpdated}
        <span> </span>
        <time datetime={profile.researchmapUpdated}>{profile.researchmapUpdated}</time>
        <span class="sr-only">{s.labels.newTab}</span>
      </a>
      {
        isMachineTranslated(locale) && (
          <>
            <span aria-hidden="true"> · </span>
            {s.translation.footerNote}
          </>
        )
      }
    </p>
  </div>
</footer>
