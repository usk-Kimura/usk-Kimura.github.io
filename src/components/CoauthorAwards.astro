---
import type { CoauthorAward, Locale } from '~/data/types';
import { L } from '~/i18n/locale';
import { t } from '~/i18n/ui';

type Props = {
  awards: CoauthorAward[];
  locale: Locale;
};

const { awards, locale } = Astro.props;
const s = t(locale);
---

<ul class="space-y-1" aria-label={s.labels.coauthorAward}>
  {
    awards.map((award) => (
      <li class="text-sm leading-relaxed">
        <span class="tag tag-accent">{s.labels.coauthorAward}</span>
        <span aria-hidden="true"> · </span>
        {award.url ? (
          <a
            href={award.url}
            target="_blank"
            rel="noopener noreferrer external"
            class="link"
          >
            {L(award.name, locale)}
            <span aria-hidden="true"> ↗</span>
            <span class="sr-only">{s.labels.newTab}</span>
          </a>
        ) : (
          <span>{L(award.name, locale)}</span>
        )}
        <span class="text-muted">
          {' — '}{s.labels.recipient}:{' '}
          {award.recipientUrl ? (
            <a
              href={award.recipientUrl}
              target="_blank"
              rel="noopener noreferrer external"
              class="link-quiet"
            >
              {award.recipient}
              <span aria-hidden="true"> ↗</span>
              <span class="sr-only">{s.labels.newTab}</span>
            </a>
          ) : (
            award.recipient
          )}
        </span>
      </li>
    ))
  }
</ul>
