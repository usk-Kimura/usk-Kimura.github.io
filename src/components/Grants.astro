---
import type { Locale } from '~/data/types';
import { grantCategoryOrder, grants } from '~/data';
import { t } from '~/i18n/ui';
import { L } from '~/i18n/locale';
import { formatAmountJpy, formatRangeParts, isoYearMonth } from '~/i18n/format';
import Section from './Section.astro';

type Props = { locale: Locale };
const { locale } = Astro.props;
const s = t(locale);

const supportGroups = grantCategoryOrder.map((category) => ({
  category,
  items: grants.filter((grant) => grant.category === category),
})).filter((group) => group.items.length > 0);

/** `2026.04 – 2027.03`, with each half in its own `<time>`. */
function range(start: string, end?: string) {
  return formatRangeParts(start, end, locale, s.labels.present);
}
---

<Section id="grants" title={s.sections.grants} home>
  <div class="space-y-8">
    {
      supportGroups.map((group) => (
        <section aria-labelledby={`grant-category-${group.category}`}>
          <h3
            id={`grant-category-${group.category}`}
            class="flex items-baseline gap-2 text-sm font-semibold text-muted"
          >
            <span>{s.grantCategories[group.category]}</span>
            <span class="font-normal tabular-nums">({group.items.length})</span>
          </h3>
          <ol class="divided mt-2">
            {group.items.map((grant) => {
              const parts = range(grant.start, grant.end);
              const facts = [
                grant.number ? `${s.labels.projectNumber} ${grant.number}` : null,
                grant.amountJpy
                  ? `${s.labels.amount} ${formatAmountJpy(grant.amountJpy, locale)}`
                  : null,
                grant.role ? L(grant.role, locale) : null,
              ].filter(Boolean) as string[];

              return (
                <li class="entry">
                  <p class="entry-date">
                    <time datetime={isoYearMonth(grant.start)}>{parts.start}</time>
                    <span aria-hidden="true"> – </span>
                    <time datetime={isoYearMonth(grant.end)}>{parts.end}</time>
                  </p>
                  <div class="min-w-0">
                    <h4 class="leading-snug font-medium">
                      {grant.url ? (
                        <a
                          href={grant.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="link"
                        >
                          {L(grant.title, locale)}
                          <span aria-hidden="true"> ↗</span>
                          <span class="sr-only">{s.labels.newTab}</span>
                        </a>
                      ) : (
                        L(grant.title, locale)
                      )}
                    </h4>
                    <p class="mt-0.5 text-sm text-muted">{L(grant.funder, locale)}</p>
                    {facts.length > 0 && (
                      <ul class="flagset mt-1.5">
                        {facts.map((fact) => (
                          <li>{fact}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }
  </div>
</Section>
