---
import type { Locale, Publication, SourceLocale } from '~/data/types';
import { t } from '~/i18n/ui';
import { formatYearMonth } from '~/i18n/format';
import { localizePath } from '~/i18n/locale';
import { pubSlug, highlightSelf } from '~/data/util';

type Props = {
  pub: Publication;
  locale: Locale;
  /** Optional line shown above the title (used by the selected-work list). */
  note?: string;
};

const { pub, locale, note } = Astro.props;
const s = t(locale);

const detailHref = localizePath(`/p/${pubSlug(pub)}/`, locale);
const externalUrl = pub.url ?? (pub.doi ? `https://doi.org/${pub.doi}` : null);

const publicationDate = pub.month
  ? `${pub.year}-${pub.month}${pub.day ? `-${pub.day}` : ''}`
  : `${pub.year}`;
const dateLabel = pub.month ? formatYearMonth(publicationDate, locale) : `${pub.year}`;
const dateAttr = pub.month
  ? `${pub.year}-${String(pub.month).padStart(2, '0')}${pub.day ? `-${String(pub.day).padStart(2, '0')}` : ''}`
  : String(pub.year);

// Titles and venues are shown as published, so they need their own `lang` for
// screen readers and line breaking regardless of the page locale.
const CJK = /[　-ヿ㐀-䶿一-鿿＀-￯]/;
const titleLang: SourceLocale = pub.titleLang ?? (CJK.test(pub.title) ? 'ja' : 'en');
const useVenueEn = locale !== 'ja' && Boolean(pub.venueEn);
const venueText = useVenueEn ? pub.venueEn! : pub.venue;
const venueLang: SourceLocale = useVenueEn ? 'en' : CJK.test(pub.venue) ? 'ja' : 'en';
---

<article class="entry">
  <p class="entry-date">
    <time datetime={dateAttr}>{dateLabel}</time>
    <span class="block">{s.pubTypes[pub.type]}</span>
  </p>

  <div class="min-w-0">
    {note && <p class="tag tag-accent mb-0.5">{note}</p>}

    <h3 class="leading-snug font-medium">
      <a href={detailHref} class="link" lang={titleLang}>{pub.title}</a>
    </h3>

    <p class="mt-1 text-sm text-muted" set:html={highlightSelf(pub.authors)} />

    {/* Full contrast, unlike the author line: where a paper appeared is the
        thing readers scan a publication list for. */}
    <p class="text-sm">
      <em lang={venueLang}>{venueText}</em>{pub.pages ? `, ${pub.pages}` : ''}
    </p>

    {
      ((pub.flags && pub.flags.length > 0) || externalUrl) && (
        <ul class="flagset mt-1.5">
          {pub.flags?.map((f) => <li>{s.flags[f]}</li>)}
          {externalUrl && (
            <li>
              <a href={externalUrl} target="_blank" rel="noopener noreferrer external" class="link">
                {pub.doi ? 'DOI' : s.labels.external}
                <span aria-hidden="true"> ↗</span>
                <span class="sr-only">{s.labels.newTab}</span>
              </a>
            </li>
          )}
        </ul>
      )
    }
  </div>
</article>
