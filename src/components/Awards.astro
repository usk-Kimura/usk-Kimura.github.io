---
import type { Locale } from '~/data/types';
import { awards } from '~/data';
import { t } from '~/i18n/ui';
import { formatYearMonth, isoYearMonth } from '~/i18n/format';
import Section from './Section.astro';

type Props = { locale: Locale };
const { locale } = Astro.props;
const s = t(locale);
const pitchAwards = awards.filter((award) => award.kind === 'business-pitch');
const academicAwards = awards.filter((award) => award.kind !== 'business-pitch');
const pitch = pitchAwards[0];
---

<Section
  id="awards"
  eyebrow={locale === 'ja' ? '受賞・社会実装' : 'RECOGNITION'}
  title={s.sections.awards}
  count={awards.length}
  countLabel={s.labels.total}
>
  {
    pitch && (
      <section class="surface-warm mb-10 overflow-hidden p-5 md:p-7" aria-labelledby="venture-awards-heading">
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1.2fr)_minmax(18rem,0.8fr)] lg:items-start">
          <div>
            <p class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-[var(--highlight)]">
              {locale === 'ja' ? '事業・社会実装の受賞' : 'Venture & social impact'}
            </p>
            <h3 id="venture-awards-heading" class="mt-2 font-serif text-xl md:text-2xl font-semibold leading-snug">
              {pitch.work[locale]}
            </h3>
            {pitch.context && <p class="mt-3 max-w-2xl text-sm leading-relaxed">{pitch.context[locale]}</p>}
            {pitch.link && (
              <a
                href={pitch.link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex min-h-10 items-center gap-1 rounded-md border border-[var(--highlight-border)] bg-[var(--bg-elev)] px-3 py-2 text-sm font-semibold text-[var(--highlight)] transition-colors hover:border-[var(--highlight)]"
              >
                {pitch.link.label[locale]}
                <span aria-hidden="true">↗</span>
                <span class="sr-only">{locale === 'ja' ? '（新しいタブで開きます）' : '(opens in a new tab)'}</span>
              </a>
            )}
          </div>

          <div class="rounded-xl border border-[var(--highlight-border)] bg-[var(--bg-elev)] p-4">
            <p class="text-xs font-semibold text-[var(--highlight)]">
              {locale === 'ja' ? 'ミライノピッチ2025（学生の部）' : 'Miraino Pitch 2025 — Student Division'}
            </p>
            <ul class="mt-3 divide-y hairline">
              {pitchAwards.map((award) => (
                <li class="py-3 first:pt-0 last:pb-0">
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <p class="font-semibold leading-snug">{award.name[locale]}</p>
                      <p class="mt-1 text-xs text-muted">{award.organization[locale]}</p>
                    </div>
                    <time class="shrink-0 font-mono text-xs text-muted" datetime={isoYearMonth(award.date)}>
                      {formatYearMonth(award.date, locale)}
                    </time>
                  </div>
                </li>
              ))}
            </ul>
            <p class="mt-4 border-t hairline pt-3 text-xs text-muted">
              <span class="font-mono tracking-wide">{s.labels.recipients}</span>: {pitch.recipients}
            </p>
          </div>
        </div>
      </section>
    )
  }

  <section aria-labelledby="academic-awards-heading">
    <h3 id="academic-awards-heading" class="mb-4 font-serif text-xl">
      {locale === 'ja' ? '研究・学術の受賞' : 'Research & academic awards'}
    </h3>
    <ol class="grid gap-4 md:grid-cols-2">
      {
        academicAwards.map((award) => (
          <li class="surface flex flex-col gap-2 p-5 md:p-6">
            <div class="flex items-baseline justify-between gap-3">
              <time class="font-mono text-xs text-muted tabular-nums" datetime={isoYearMonth(award.date)}>
                {formatYearMonth(award.date, locale)}
              </time>
              <p class="text-right text-xs text-muted">{award.organization[locale]}</p>
            </div>
            <h4 class="font-serif text-lg leading-snug">{award.name[locale]}</h4>
            <p class="text-sm text-muted">{award.work[locale]}</p>
            <p class="mt-auto pt-2 text-sm text-muted">
              <span class="font-mono text-xs tracking-wide">{s.labels.recipients}</span>: {award.recipients}
            </p>
          </li>
        ))
      }
    </ol>
  </section>
</Section>
