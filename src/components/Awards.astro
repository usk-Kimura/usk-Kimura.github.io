---
import type { Locale } from '~/data/types';
import { awards } from '~/data';
import { t, fmt } from '~/i18n/ui';
import { L } from '~/i18n/locale';
import { formatYearMonth, isoYearMonth } from '~/i18n/format';
import Section from './Section.astro';

type Props = { locale: Locale };
const { locale } = Astro.props;
const s = t(locale);
---

<Section id="awards" title={s.sections.awards} meta={fmt(s.counts.awards, { n: awards.length })}>
  <ol class="divided">
    {
      awards.map((award) => (
        <li class="entry">
          <p class="entry-date">
            <time datetime={isoYearMonth(award.date)}>{formatYearMonth(award.date, locale)}</time>
          </p>
          <div class="min-w-0">
            <h3 class="leading-snug font-medium">{L(award.name, locale)}</h3>
            <p class="mt-0.5 text-sm text-muted">{L(award.organization, locale)}</p>
            <p class="mt-1.5 text-sm">{L(award.work, locale)}</p>
            {award.context && (
              <p class="mt-1 text-sm text-muted">{L(award.context, locale)}</p>
            )}
            {award.link && (
              <p class="mt-1.5 text-sm">
                <a
                  href={award.link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link"
                >
                  {L(award.link.label, locale)}
                  <span aria-hidden="true"> ↗</span>
                  <span class="sr-only">{s.labels.newTab}</span>
                </a>
              </p>
            )}
            <p class="mt-1.5 text-xs text-muted">
              {s.labels.recipients}: {award.recipients}
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</Section>
