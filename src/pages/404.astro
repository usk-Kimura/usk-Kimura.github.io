---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { locales, localeMeta } from '~/i18n/locale';
import { t } from '~/i18n/ui';

// GitHub Pages serves this single file for every unmatched path, including
// ones under /en/, /zh/, and /ko/ — so it offers a way home in all four
// languages rather than assuming the visitor reads Japanese.
const locale = 'ja' as const;
---

<BaseLayout locale={locale} title="404" description="ページが見つかりませんでした．" noindex>
  <section class="container-page py-20 md:py-28">
    <p class="text-sm text-muted">404</p>
    <h1 class="mt-2 text-2xl font-bold tracking-tight md:text-3xl">
      {t('ja').notFound.title}
    </h1>
    <p class="mt-1 text-2xl font-bold tracking-tight text-muted md:text-3xl" lang="en">
      {t('en').notFound.title}
    </p>

    <ul class="mt-8 space-y-2 text-sm">
      {
        locales.map((l) => (
          <li>
            <a href={localeMeta[l].prefix || '/'} hreflang={localeMeta[l].lang} class="link">
              <span lang={localeMeta[l].lang}>
                {localeMeta[l].label}
                <span aria-hidden="true"> — </span>
                {t(l).actions.backHome}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
