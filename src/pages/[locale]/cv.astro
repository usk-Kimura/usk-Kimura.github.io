---
import type { GetStaticPaths } from 'astro';
import type { Locale } from '~/data/types';
import BaseLayout from '~/layouts/BaseLayout.astro';
import CV from '~/components/CV.astro';
import { profile } from '~/data';
import { L, prefixedLocales } from '~/i18n/locale';
import { t, fmt } from '~/i18n/ui';

export const getStaticPaths = (() =>
  prefixedLocales.map((locale) => ({
    params: { locale },
    props: { locale },
  }))) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const s = t(locale);
---

<BaseLayout
  locale={locale}
  title={s.cv.title}
  description={fmt(s.meta.cv, { name: L(profile.name, locale) })}
  path="/cv/"
  wide
>
  <CV locale={locale} />
</BaseLayout>
