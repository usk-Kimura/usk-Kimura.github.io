---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Publications from '~/components/Publications.astro';
import { profile } from '~/data';
import { L } from '~/i18n/locale';
import { t, fmt } from '~/i18n/ui';

const locale = 'ja' as const;
const s = t(locale);
---

<BaseLayout
  locale={locale}
  title={s.sections.researchOutputs}
  description={fmt(s.meta.publications, { name: L(profile.name, locale) })}
  path="/publications/"
>
  <Publications locale={locale} />
</BaseLayout>
